              <span>⛶</span> Full Screen
            </button>
          </div>
        </div>

      </div>

      <!-- PM Modal Footer -->
      <div class="mt-6 pt-4 border-t border-slate-200 flex items-center justify-between">
        <button onclick="restartFullGame(); closeModal('pm-modal');" class="text-xs font-bold text-red-600 hover:text-red-700 underline">
