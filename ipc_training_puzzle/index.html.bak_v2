  <!-- MODAL: TRAINER DEBRIEF KEY & CLINICAL RATIONALE -->
  <div id="debrief-modal" class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-5 hidden">
    <div class="bg-white border border-slate-300 rounded-3xl max-w-4xl w-full p-5 sm:p-8 shadow-2xl relative max-h-[92vh] overflow-y-auto">
      
      <div class="flex items-center justify-between pb-3.5 border-b border-slate-200 mb-4">
        <div class="flex items-center gap-3">
          <img src="ipc-logo.jpg" alt="Logo" class="w-12 h-12 object-contain rounded-xl" />
          <div>
            <h2 class="text-lg sm:text-xl font-black text-slate-900 flex items-center gap-2">
              📋 IPC Trainer Facilitator Key & Answers
            </h2>
            <p class="text-xs text-slate-500">CDC & WHO Standard Precautions • Authored by Hammam Jubran Rjoup /MSN, CPIC</p>
          </div>
        </div>
        <button onclick="closeModal('debrief-modal')" class="px-3 py-1.5 rounded-lg bg-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-300">
          ✕ Close
        </button>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-slate-700">
        <!-- 6 Links Summary -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <h3 class="font-bold text-cyan-800 text-sm mb-2">Stage 1: The 6 Chain of Infection Links (Clockwise Order)</h3>
          <ol class="list-decimal list-inside space-y-1">
            <li><strong>1. Agent (Microorganisms)</strong>: Bacteria (MRSA, C. diff), Viruses (Influenza, COVID-19), Fungi, Parasites.</li>
            <li><strong>2. Reservoir/Source</strong>: Habitats where pathogens multiply: patients, staff, water, surfaces, medical devices.</li>
            <li><strong>3. Portal of Exit</strong>: Escape route: respiratory tract, blood, broken skin, secretions, stool.</li>
            <li><strong>4. Modes of Transport</strong>: Transmission route: contaminated hands (#1 mode!), direct contact, droplets, airborne.</li>
            <li><strong>5. Portal of Entry</strong>: Route into vulnerable host: broken skin, IV cannulas, urinary catheters, mucous membranes.</li>
            <li><strong>6. Susceptible Host</strong>: Individuals with reduced immunity: surgical patients, immunocompromised, elderly, neonates.</li>
          </ol>
        </div>

        <!-- 10 Precautions & Chain Disruption -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <h3 class="font-bold text-emerald-800 text-sm mb-2">Stage 2: 10 Standard Precautions & Where They Break the Chain</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5 text-xs">
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">1. Hand Hygiene:</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Mode of Transport</em> and <em>Portal of Entry</em>. The single most impactful intervention to prevent cross-contamination.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">2. PPE (Gloves, Gown, Mask, Eye Shield):</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Portal of Exit</em>, <em>Mode of Transport</em>, and <em>Portal of Entry</em> barrier.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">3. Respiratory Hygiene & Cough Etiquette:</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Portal of Exit</em> and <em>Mode of Transport</em> via source containment at expulsion.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">4. Environmental Cleaning:</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Reservoir</em> and <em>Mode of Transport</em> by disinfecting high-touch surfaces.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">5. Instruments Processing (Sterilization):</span>
              <p class="text-slate-600 mt-0.5">Directly kills the <em>Agent</em> and protects <em>Portal of Entry</em> during surgical procedures.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">6. Cleaning Patient Care Equipment:</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Reservoir</em> on shared clinical equipment (BP cuffs, stethoscopes, monitors).</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">7. Sharps Safety & Needlestick Prevention:</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Portal of Entry</em> against bloodborne pathogens (HIV, HBV, HCV).</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">8. Linen Management:</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Reservoir</em> and <em>Mode of Transport</em> during handling of soiled hospital laundry.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">9. Biohazard Waste Disposal:</span>
              <p class="text-slate-600 mt-0.5">Breaks <em>Reservoir</em> through compliant containment and incineration of biohazards.</p>
            </div>
            <div class="p-2.5 rounded-lg bg-white border border-slate-200">
              <span class="font-bold text-slate-900">10. Protect Workers & Immunization:</span>
              <p class="text-slate-600 mt-0.5">Protects the <em>Susceptible Host</em> and stops healthcare personnel from acting as reservoirs.</p>
            </div>
          </div>
        </div>

        <!-- 10-Minute Timeline -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <h3 class="font-bold text-amber-700 text-sm mb-1">Trainer 10-Minute Timeline</h3>
          <ul class="space-y-1 text-slate-600 text-xs">
            <li><strong>00:00 - 01:00</strong>: Team briefing, role assignment, start 10-min countdown.</li>
            <li><strong>01:00 - 04:00</strong>: Stage 1 — Assemble the 6 Chain of Infection links in order.</li>
            <li><strong>04:00 - 08:30</strong>: Stage 2 — Break the Chain scenarios deploying Standard Precautions.</li>
            <li><strong>08:30 - 10:00</strong>: Debrief rationale, award certificate, and download scores CSV.</li>
          </ul>
        </div>
      </div>

    </div>
  </div>

  <!-- CORE GAME LOGIC SCRIPT -->
  <script>
    // 1. DATA DEFINITIONS
    const CHAIN_LINKS = [
      {
        id: 0,
        name: "Agent (Microorganisms)",
        shortName: "Agent",
        icon: "🦠",
        examples: "Bacteria, Viruses, Fungi, Parasites (MRSA, C. diff, COVID-19)",
        desc: "Pathogen producing disease."
      },
      {
        id: 1,
        name: "Reservoir/Source",
        shortName: "Reservoir",
        icon: "🏥",
        examples: "Patients, Staff, Water, Equipment, Bed rails",
        desc: "Habitat where pathogen multiplies."
      },
      {
        id: 2,
        name: "Portal of Exit",
        shortName: "Portal of Exit",
        icon: "🚪",
        examples: "Respiratory droplets, Blood, Secretions, Wounds",
        desc: "Path by which pathogen escapes."
      },
      {
        id: 3,
        name: "Modes of Transport",
        shortName: "Mode of Transport",
        icon: "🖐️",
        examples: "Unwashed hands (#1), Contact, Droplets, Equipment",
        desc: "Route agent travels to host."
      },
      {
        id: 4,
        name: "Portal of Entry",
        shortName: "Portal of Entry",
        icon: "💉",
        examples: "Broken skin, IV cannula, Catheter, Mucosa",
        desc: "Route pathogen enters new host."
      },
      {
        id: 5,
        name: "Susceptible Host",
        shortName: "Susceptible Host",
        icon: "🧑‍🦽",
        examples: "Immunocompromised, Post-op, Elderly, Unvaccinated",
        desc: "Person lacking immunity."
      }
    ];

    const STANDARD_PRECAUTIONS = [
      { id: "hand_hygiene", name: "Hand hygiene", icon: "🧼", breaks: [3, 1, 4] },
      { id: "ppe", name: "Personal Protective Equipment (PPE)", icon: "🧤", breaks: [2, 3, 4] },
      { id: "respiratory", name: "Respiratory Hygiene & Cough Etiquette", icon: "😷", breaks: [2, 3] },
      { id: "environmental", name: "Environmental cleaning", icon: "🧹", breaks: [1, 3] },
      { id: "cleaning_equipment", name: "Cleaning patient care equipment", icon: "🩺", breaks: [1, 3] },
      { id: "instruments", name: "Instruments Processing", icon: "🔬", breaks: [0, 4] },
      { id: "sharps", name: "Sharps; Needle Stick Prevention", icon: "💉", breaks: [4, 2] },
      { id: "linen", name: "Linen care", icon: "🛏️", breaks: [1, 3] },
      { id: "waste", name: "Appropriate Waste Disposal", icon: "🗑️", breaks: [1, 3] },
      { id: "protect_workers", name: "Protect workers & immunizations", icon: "🛡️", breaks: [5, 1] }
    ];

    const CLINICAL_SCENARIOS = [
      {
        id: 1,
        targetNode: 3,
        question: "Between examining an infected wound and touching the next patient's IV line, what is the single most critical standard precaution to BREAK the mode of transport?",
        hint: "Primary vehicle of nosocomial cross-transmission in healthcare.",
        correctId: "hand_hygiene",
        rationale: "Hand hygiene breaks the Mode of Transport (pathogen transfer on healthcare worker hands)."
      },
      {
        id: 2,
        targetNode: 4,
        question: "A doctor finishes arterial blood gas sampling. To prevent percutaneous puncture and exposure to bloodborne pathogens, which precaution is essential?",
        hint: "Never recap needles by two hands; immediately place in puncture-resistant container.",
        correctId: "sharps",
        rationale: "Sharps safety breaks Portal of Entry (percutaneous injury) and Portal of Exit."
      },
      {
        id: 3,
        targetNode: 0,
        question: "Surgical instruments used during a major abdominal surgery must have all bacterial spores, viruses, and vegetative cells completely destroyed before next use. Which element achieves this?",
        hint: "Autoclaving, high-level disinfection, and CSSD validation.",
        correctId: "instruments",
        rationale: "Instruments processing (autoclave/sterilization) breaks the Agent link directly by killing all pathogens."
      },
      {
        id: 4,
        targetNode: 2,
        question: "A patient in the crowded ER waiting room is coughing violently with fever and chills. Which standard precaution immediately stops droplets at their source?",
        hint: "Offer mask, provide tissues, advise covering nose and mouth.",
        correctId: "respiratory",
        rationale: "Respiratory hygiene and cough etiquette breaks Portal of Exit (respiratory tract expulsion)."
      },
      {
        id: 5,
        targetNode: 1,
        question: "A hospital bed rail and call bell in a high-turnover ward are contaminated with multi-drug resistant organisms (MDRO). Which precaution eradicates this reservoir?",
        hint: "Routine disinfection with EPA-registered hospital grade disinfectant.",
        correctId: "environmental",
        rationale: "Environmental cleaning breaks the Reservoir/Source by decontaminating inanimate clinical surfaces."
      },
      {
        id: 6,
        targetNode: 4,
        question: "During an emergency intubation with heavy airway secretions and blood spray, the medical team dons face shields, N95 respirators, gloves, and fluid-resistant gowns.",
        hint: "Barriers protecting healthcare worker mucous membranes and skin.",
        correctId: "ppe",
        rationale: "PPE breaks Portal of Entry (eyes, nose, mouth) and prevents contact transmission."
      },
      {
        id: 7,
        targetNode: 5,
        question: "A newly hired nursing graduate receives Hepatitis B vaccination series and MMR titer checks before clinical assignment in oncology. What precaution protects the host?",
        hint: "Building acquired immunity against vaccine-preventable occupational pathogens.",
        correctId: "protect_workers",
        rationale: "Immunization and worker health protect the Susceptible Host from acquiring and spreading infection."
      },
      {
        id: 8,
        targetNode: 1,
        question: "A shared portable ultrasound machine and blood pressure cuff were used in an isolation room. What precaution must occur before moving them to the general ward?",
        hint: "Cleaning and disinfecting non-critical patient care devices between every patient.",
        correctId: "cleaning_equipment",
        rationale: "Cleaning patient care equipment breaks Reservoir and Mode of Transport on medical devices."
      },
      {
        id: 9,
        targetNode: 1,
        question: "Bed sheets heavily soiled with purulent discharge are removed from an occupied bed. Staff bundle them without shaking and place them in leak-proof bags. Which precaution is this?",
        hint: "Prevents microbial aerosolization and contamination of uniforms.",
        correctId: "linen",
        rationale: "Linen care breaks Reservoir and Mode of Transport during handling of soiled textiles."
      },
      {
        id: 10,
        targetNode: 1,
        question: "A suction canister containing 1000 mL of bloody pleural fluid needs disposal. Staff deposit it into the designated biohazard waste stream rather than domestic trash.",
        hint: "Color-coded biohazard containment and regulatory hazardous waste management.",
        correctId: "waste",
        rationale: "Appropriate waste disposal eliminates infectious clinical reservoirs safely."
      }
    ];

    // 1B. ICE BREAKER CLINICAL DILEMMAS & MYTH BUSTERS DATA
    const ICE_BREAKER_DATA = [
      {
        id: 1,
        topic: "Hand Hygiene & Spores",
        icon: "🧼",
        title: "Dilemma 1: The C. Difficile Hand Hygiene Trap",
        vignette: "A nurse finishes examining and changing bed linens for a hospitalized patient with confirmed Clostridioides difficile colitis (profuse watery diarrhea).",
        question: "Which hand hygiene method is mandatory before touching the next patient or medical devices?",
        choices: [
          { text: "Wash with Soap & Running Water for 40-60 seconds (Mechanical spore clearance)", correct: true },
          { text: "Rub with 70% Alcohol-Based Hand Sanitizer for 20-30 seconds", correct: false }
        ],
        rationale: "Alcohol does NOT kill bacterial endospores (C. difficile, Bacillus anthracis). Mechanical friction with soap and running water is clinically and legally mandatory to physically dislodge and rinse spores off hands into the sink drain.",
        standardsRef: "WHO Hand Hygiene Guidelines & CDC C. diff Core Prevention Recommendations"
      },
      {
        id: 2,
        topic: "Staff Grooming & Nails",
        icon: "💅",
        title: "Dilemma 2: Artificial Nails in Intensive Care Units",
        vignette: "An ICU resident physician wears short, manicured artificial gel extension nails under their examination gloves during clinical rounds.",
        question: "According to WHO & CDC evidence-based guidelines, are artificial nails permitted for clinical staff in high-risk areas?",
        choices: [
          { text: "Strictly Prohibited — Proven vector for fatal gram-negative & fungal outbreaks", correct: true },
          { text: "Permitted if gloves fit securely and nails are under 0.5 cm in length", correct: false }
        ],
        rationale: "Subungual areas under artificial nails harbor massive bioburdens of Pseudomonas aeruginosa, Serratia marcescens, and Candida that resist both standard hand hygiene and surgical scrubs. CDC strictly forbids them in high-risk zones.",
        standardsRef: "CDC Healthcare Personnel Hand Hygiene & WHO Core IPC Components"
      },
      {
        id: 3,
        topic: "Diagnostic Equipment",
        icon: "🩺",
        title: "Dilemma 3: The Stethoscope Transmission Vector",
        vignette: "A physician finishes chest auscultation on an elderly patient in the medical ward and immediately moves to the adjacent bed.",
        question: "How frequently must stethoscope diaphragms be sanitized with 70% isopropyl alcohol?",
        choices: [
          { text: "Between every single patient encounter without exception", correct: true },
          { text: "Once at the end of the shift during routine equipment cleaning", correct: false }
        ],
        rationale: "Clinical cultures prove stethoscope diaphragms acquire bacterial bioburdens equal to fingertips immediately upon contact with skin. Stethoscopes are primary vectors for MDRO cross-transmission (MRSA, VRE).",
        standardsRef: "CDC Guidelines for Disinfection & Sterilization in Healthcare Facilities"
      },
      {
        id: 4,
        topic: "PPE: Glove Safety",
        icon: "🧤",
        title: "Dilemma 4: The Glove Sanitization Fallacy",
        vignette: "A healthcare worker empties a urinary catheter drainage bag, then prepares to adjust the patient's peripheral IV infusion rate.",
        question: "Can the healthcare worker sanitize their gloved hands with alcohol rub to save time between tasks?",
        choices: [
          { text: "Never! Remove gloves, perform hand hygiene, then don new gloves", correct: true },
          { text: "Yes, if the gloves show no visible bodily fluid contamination", correct: false }
        ],
        rationale: "Gloves are strictly single-use disposables. Alcohol induces microscopic porosity (pinhole degradation) in latex and nitrile, causing leakage and cross-contamination. Always doff gloves, sanitize hands, and don fresh gloves.",
        standardsRef: "WHO Glove Use Information Leaflet & CDC Standard Precautions"
      },
      {
        id: 5,
        topic: "Respiratory Protection",
        icon: "😷",
        title: "Dilemma 5: The 'Chin-Mask' Contamination Reflex",
        vignette: "A doctor pulls their surgical mask down under their chin to speak to a colleague in the corridor, then pulls it back up over their mouth and nose.",
        question: "Why does pulling a mask down under the chin violate standard infection control principles?",
        choices: [
          { text: "Neck skin bacteria wipe onto inner lining, then inhaled directly into airway", correct: true },
          { text: "It only stretches ear loops, slightly reducing fit without infection risk", correct: false }
        ],
        rationale: "The anterior neck is heavily colonized with skin flora and sweat. Lowering the mask wipes these microorganisms directly onto the inner breathable filter, which inoculates the clinician's mucous membranes when restored.",
        standardsRef: "CDC Personal Protective Equipment Guidance for Healthcare Personnel"
      },
      {
        id: 6,
        topic: "Healthcare Attire",
        icon: "👔",
        title: "Dilemma 6: 'Bare Below the Elbows' vs. Neckties",
        vignette: "A consultant physician rounds in the surgical ward wearing a long-sleeved dress shirt with an uncovered silk necktie.",
        question: "Which evidence-based dress policy significantly reduces inanimate pathogen transfer between hospital beds?",
        choices: [
          { text: "'Bare Below the Elbows' — sleeves rolled up, no neckties, no wrist jewelry", correct: true },
          { text: "Long sleeves buttoned to wrists to protect the clinician's forearms", correct: false }
        ],
        rationale: "Sleeve cuffs and swinging neckties contact beds, linens, and dressings, acting as notorious mobile fomites. 'Bare Below the Elbows' permits thorough forearm washing and eliminates contaminated textile transfer.",
        standardsRef: "NHS & WHO Guidelines on Clinical Attire and Inanimate Fomite Control"
      },
      {
        id: 7,
        topic: "WHO 5 Moments",
        icon: "🛏️",
        title: "Dilemma 7: Touching Patient Surroundings (Moment 5)",
        vignette: "You walk into an isolation room, adjust the bedside cardiac monitor touch screen, and leave without touching the patient's body.",
        question: "Is hand hygiene required upon exiting the room?",
        choices: [
          { text: "Yes! WHO Moment 5: After touching patient surroundings", correct: true },
          { text: "No, hand hygiene is only necessary following direct human skin contact", correct: false }
        ],
        rationale: "Environmental touch surfaces in the patient zone (monitors, call bells, IV poles, bed rails) harbor heavy colonization of nosocomial organisms. Touching surroundings inoculates hands just as heavily as touching intact skin.",
        standardsRef: "WHO 5 Moments for Hand Hygiene Framework"
      },
      {
        id: 8,
        topic: "Sharps & Percutaneous Safety",
        icon: "💉",
        title: "Dilemma 8: Needle Recapping Post-Venipuncture",
        vignette: "A nurse draws blood from a patient in the emergency department and the sharps container is 3 meters away across the room.",
        question: "What is the only acceptable method to handle the contaminated needle?",
        choices: [
          { text: "Carry immediately to sharps container or use active one-handed scoop technique", correct: true },
          { text: "Two-handed recapping while holding the plastic sheath with fingertips", correct: false }
        ],
        rationale: "Two-handed recapping is the primary cause of occupational needle-stick injuries and transmission of bloodborne viruses (Hepatitis B, Hepatitis C, HIV). Never use two hands; use safety-engineered locks or single-hand disposal.",
        standardsRef: "OSHA Bloodborne Pathogens Standard & WHO Safe Injection Global Guidelines"
      }
    ];

    // 2. STATE MANAGEMENT
    let teams = [
      { id: "team-1", name: "Group 1", score: 0, stage1Complete: false, brokenLinks: 0, correctCount: 0, wrongCount: 0 },
      { id: "team-2", name: "Group 2", score: 0, stage1Complete: false, brokenLinks: 0, correctCount: 0, wrongCount: 0 }
    ];
    let currentTeamIndex = 0;

    let currentMainView = 'puzzle';
    let currentIceBreakerIndex = 0;
    let iceBreakerAnswered = [false, false, false, false, false, false, false, false];

    let boardSlots = [null, null, null, null, null, null];
    let selectedPieceId = null;
    let currentStage = 1;
    let currentScenarioIndex = 0;
    let brokenLinksSet = new Set();
    let boardViewMode = 'template';

    // Shuffled choices state for Stage 1 & Stage 2
    let shuffledChainLinks = [...CHAIN_LINKS];
    let shuffledPrecautions = [...STANDARD_PRECAUTIONS];

    function shuffleArray(array) {
      const arr = [...array];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function shuffleStage1Choices() {
      let shuffled = shuffleArray(CHAIN_LINKS);
      // Guarantee it is randomized and not identical to natural sequential order 0..5
      let attempts = 0;
      while (attempts < 20 && shuffled.every((item, idx) => item.id === idx)) {
        shuffled = shuffleArray(CHAIN_LINKS);
        attempts++;
      }
      shuffledChainLinks = shuffled;
    }

    function shuffleStage2Choices() {
      let shuffled = shuffleArray(STANDARD_PRECAUTIONS);
      let attempts = 0;
      while (attempts < 20 && shuffled.every((item, idx) => item.id === STANDARD_PRECAUTIONS[idx].id)) {
        shuffled = shuffleArray(STANDARD_PRECAUTIONS);
        attempts++;
      }
      shuffledPrecautions = shuffled;
    }

    function shuffleAllChoices(notify = false) {
      shuffleStage1Choices();
      shuffleStage2Choices();
      renderChainPiecesBank();
      renderPrecautionsGrid();
      if (notify) {
        sound.playLock();
        showToast("🔀 Choices Shuffled!", "Stage 1 labels and Stage 2 precautions randomized for new challenge.", "cyan");
      }
    }

    function shuffleAndRenderStage1(notify = false) {
      shuffleStage1Choices();
      renderChainPiecesBank();
      if (notify) {
        sound.playLock();
        showToast("🔀 Labels Shuffled!", "Stage 1 Chain of Infection labels re-randomized.", "cyan");
      }
    }

    function shuffleAndRenderStage2(notify = false) {
      shuffleStage2Choices();
      renderPrecautionsGrid();
      if (notify) {
        sound.playLock();
        showToast("🔀 Precautions Shuffled!", "Stage 2 Standard Precautions re-randomized.", "emerald");
      }
    }

    // Timer state
    let sessionSeconds = 600;
    let totalSeconds = 600;
    let timerInterval = null;
    let isTimerRunning = false;

    // 3. INITIALIZATION
    window.addEventListener('DOMContentLoaded', () => {
      shuffleStage1Choices();
      shuffleStage2Choices();
      renderTeamTabs();
      renderChainPiecesBank();
      renderPrecautionsGrid();
      updateScoreboardUI();
      loadScenario(0);
      setupDropZones();
      setupPointerDragSystem();
      updatePMUI();
      renderArchiveList();
      renderIceBreakerCard();
      updateLeftMenuUI();
      document.getElementById('cert-date').innerText = 'Date: ' + new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
    });

    // 4. GROUP MANAGEMENT & TURN SWITCHING
    function renderTeamTabs() {
      const tabs = document.getElementById('team-tabs');
      tabs.innerHTML = '';
      teams.forEach((t, idx) => {
        const isActive = idx === currentTeamIndex;
        const btn = document.createElement('button');
        btn.onclick = () => switchTeam(idx);
        btn.className = `px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm ${
          isActive 
            ? 'bg-gradient-to-r from-cyan-700 to-teal-700 text-white border-2 border-cyan-400 shadow-md ring-2 ring-cyan-500/30' 
            : 'bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300'
        }`;
        btn.innerHTML = `<span>👥</span> <span>${t.name}</span> <span class="ml-1 px-1.5 py-0.2 rounded-full text-[10px] bg-black/20 text-white font-mono">${t.score}</span>`;
        tabs.appendChild(btn);
      });
      document.getElementById('current-score').innerText = teams[currentTeamIndex].score;
      updatePMUI();
      updateLeftMenuUI();
    }

    function switchTeam(index) {
      currentTeamIndex = index;
      renderTeamTabs();
      updateLeftMenuUI();
      showToast('Active Turn: ' + teams[currentTeamIndex].name, 'Ready to answer & score!', 'cyan');
    }

    function moveToNextGroup() {
      currentTeamIndex = (currentTeamIndex + 1) % teams.length;
      renderTeamTabs();
      updateLeftMenuUI();
      sound.playLock();
      showToast('Turn Rotated: ' + teams[currentTeamIndex].name, 'Now answering! Discuss as a group.', 'emerald');
    }

    function addTeamPrompt() {
      const name = prompt("Enter new Group name:", `Group ${teams.length + 1}`);
      if (name && name.trim()) {
        teams.push({
          id: `team-${Date.now()}`,
          name: name.trim(),
          score: 0,
          stage1Complete: false,
          brokenLinks: 0,
          correctCount: 0,
          wrongCount: 0
        });
        currentTeamIndex = teams.length - 1;
        renderTeamTabs();
        updateLeftMenuUI();
        sound.playSuccess();
      }
    }

    function editCurrentTeamName() {
      const current = teams[currentTeamIndex];
      const name = prompt("Rename Active Group:", current.name);
      if (name && name.trim()) {
        current.name = name.trim();
        renderTeamTabs();
        updateLeftMenuUI();
      }
    }

    function resetAllScores() {
      if (confirm("Reset scores for all groups to 0?")) {
        teams.forEach(t => {
          t.score = 0;
          t.stage1Complete = false;
          t.brokenLinks = 0;
          t.correctCount = 0;
          t.wrongCount = 0;
        });
        renderTeamTabs();
        updateLeftMenuUI();
        showToast("Scores Reset", "All group scores set to 0.", "cyan");
      }
    }

    function addScore(points) {
      teams[currentTeamIndex].score += points;
      document.getElementById('current-score').innerText = teams[currentTeamIndex].score;
      renderTeamTabs();
      updateLeftMenuUI();
    }

    function updateScoreboardUI() {
      document.getElementById('current-score').innerText = teams[currentTeamIndex].score;
      updateLeftMenuUI();
    }

    // 4B. VIEW ROUTING & LEFT NAVIGATION MENU
    function updateLeftMenuUI() {
      const activeGroup = teams[currentTeamIndex];
      const teamNameEl = document.getElementById('left-menu-team-name');
      const teamScoreEl = document.getElementById('left-menu-team-score');
      const turnBadgeEl = document.getElementById('left-menu-turn-badge');
      const puzzleStatusEl = document.getElementById('menu-puzzle-status');
      const hdrTurnName = document.getElementById('header-turn-name');
      const hdrTurnScore = document.getElementById('header-turn-score');

      if (teamNameEl) teamNameEl.innerText = activeGroup.name;
      if (teamScoreEl) teamScoreEl.innerText = activeGroup.score;
      if (turnBadgeEl) turnBadgeEl.innerText = `${activeGroup.name}'s Turn`;
      if (hdrTurnName) hdrTurnName.innerText = activeGroup.name;
      if (hdrTurnScore) hdrTurnScore.innerText = `${activeGroup.score} pts`;

      if (puzzleStatusEl) {
        if (currentStage === 1) {
          const filled = boardSlots.filter(s => s !== null).length;
          puzzleStatusEl.innerText = `Stage 1: ${filled}/6 Placed`;
          puzzleStatusEl.className = "text-[9px] font-bold text-amber-300";
        } else {
          puzzleStatusEl.innerText = `Stage 2: ${brokenLinksSet.size}/6 Broken`;
          puzzleStatusEl.className = "text-[9px] font-bold text-emerald-300";
        }
      }
    }

    function selectPuzzleWithFitMode() {
      if (currentStage === 1 && boardSlots.every(s => s === null)) {
        shuffleStage1Choices();
        renderChainPiecesBank();
      }
      switchMainView('puzzle');
      enableShrinkFitMode();
    }

    function enableShrinkFitMode() {
      document.body.classList.add('shrink-fit-active');
      const btn = document.getElementById('btn-toggle-fit');
      if (btn) {
        btn.innerHTML = '<span>📜</span> <span class="hidden sm:inline">Normal View</span>';
        btn.className = "px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-emerald-800 border-2 border-emerald-400 hover:bg-emerald-700 text-white text-xs font-black flex items-center gap-1.5 transition active:scale-95 shadow";
      }
      showToast("📐 Shrink-to-Fit Page Active", "Simulation auto-scaled to viewport without scrolling. All controls active in top bar!", "cyan");
    }

    function disableShrinkFitMode() {
      document.body.classList.remove('shrink-fit-active');
      const btn = document.getElementById('btn-toggle-fit');
      if (btn) {
        btn.innerHTML = '<span>📐</span> <span class="hidden sm:inline">Fit Screen</span>';
        btn.className = "px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-cyan-900/90 border-2 border-cyan-400 hover:bg-cyan-800 text-cyan-200 text-xs font-black flex items-center gap-1.5 transition active:scale-95 shadow";
      }
      const drawer = document.getElementById('left-nav-menu');
      if (drawer) drawer.classList.remove('drawer-open');
      const backdrop = document.getElementById('drawer-backdrop');
      if (backdrop) backdrop.classList.add('hidden');
    }

    function toggleShrinkFitMode() {
      if (document.body.classList.contains('shrink-fit-active')) {
        disableShrinkFitMode();
        showToast("Normal View Active", "Standard scrolling view enabled.", "slate");
      } else {
        enableShrinkFitMode();
      }
    }

    function toggleLeftDrawer() {
      const drawer = document.getElementById('left-nav-menu');
      const backdrop = document.getElementById('drawer-backdrop');
      if (drawer) {
        drawer.classList.toggle('drawer-open');
        if (drawer.classList.contains('drawer-open')) {
          if (backdrop) backdrop.classList.remove('hidden');
        } else {
          if (backdrop) backdrop.classList.add('hidden');
        }
      }
    }

    function switchMainView(viewName) {
      currentMainView = viewName;
      const puzzleView = document.getElementById('view-puzzle');
      const icebreakerView = document.getElementById('view-icebreaker');
      const btnPuzzle = document.getElementById('menu-btn-puzzle');
      const btnIcebreaker = document.getElementById('menu-btn-icebreaker');
      const mobPuzzle = document.getElementById('mobile-tab-puzzle');
      const mobIcebreaker = document.getElementById('mobile-tab-icebreaker');

      if (viewName === 'puzzle') {
        if (puzzleView) puzzleView.classList.remove('hidden');
        if (icebreakerView) icebreakerView.classList.add('hidden');

        if (btnPuzzle) {
          btnPuzzle.className = "w-full text-left p-3.5 rounded-2xl border-2 transition-all duration-200 flex flex-col gap-1 shadow active:scale-98 bg-gradient-to-r from-cyan-950 via-[#032347] to-cyan-900 border-cyan-400 text-white shadow-cyan-500/30 ring-2 ring-cyan-400/30";
        }
        if (btnIcebreaker) {
          btnIcebreaker.className = "w-full text-left p-3.5 rounded-2xl border-2 transition-all duration-200 flex flex-col gap-1 shadow active:scale-98 bg-slate-900/80 hover:bg-[#03203f] border-slate-700 hover:border-teal-400 text-slate-300 hover:text-white";
        }

        if (mobPuzzle && mobIcebreaker) {
          mobPuzzle.className = "flex-1 py-2 px-3 rounded-xl text-xs font-black transition flex items-center justify-center gap-1.5 bg-cyan-700 text-white shadow";
          mobIcebreaker.className = "flex-1 py-2 px-3 rounded-xl text-xs font-black transition flex items-center justify-center gap-1.5 bg-slate-100 text-slate-700 hover:bg-slate-200";
        }

        showToast("Module 1: Chain of Infection & Break Chain", "Drag or tap to assemble links and shatter transmission cycles!", "cyan");
      } else {
        disableShrinkFitMode();
        if (puzzleView) puzzleView.classList.add('hidden');
        if (icebreakerView) icebreakerView.classList.remove('hidden');

        if (btnIcebreaker) {
          btnIcebreaker.className = "w-full text-left p-3.5 rounded-2xl border-2 transition-all duration-200 flex flex-col gap-1 shadow active:scale-98 bg-gradient-to-r from-teal-950 via-[#022c3e] to-cyan-900 border-teal-400 text-white shadow-teal-500/30 ring-2 ring-teal-400/30";
        }
        if (btnPuzzle) {
          btnPuzzle.className = "w-full text-left p-3.5 rounded-2xl border-2 transition-all duration-200 flex flex-col gap-1 shadow active:scale-98 bg-slate-900/80 hover:bg-[#03203f] border-slate-700 hover:border-cyan-400 text-slate-300 hover:text-white";
        }

        if (mobPuzzle && mobIcebreaker) {
          mobIcebreaker.className = "flex-1 py-2 px-3 rounded-xl text-xs font-black transition flex items-center justify-center gap-1.5 bg-teal-700 text-white shadow";
          mobPuzzle.className = "flex-1 py-2 px-3 rounded-xl text-xs font-black transition flex items-center justify-center gap-1.5 bg-slate-100 text-slate-700 hover:bg-slate-200";
        }

        renderIceBreakerCard();
        showToast("Module 2: IPC Team Ice Breaker", "Warm-up challenge: discuss dilemmas with your group!", "emerald");
      }
      updateLeftMenuUI();
    }

    // 4C. MODULE 2: IPC TEAM ICE BREAKER CONTROLLER
    function renderIceBreakerCard() {
      const d = ICE_BREAKER_DATA[currentIceBreakerIndex];
      if (!d) return;

      const badgeEl = document.getElementById('ib-scenario-badge');
      const topicEl = document.getElementById('ib-topic-tag');
      const iconEl = document.getElementById('ib-icon');
      const titleEl = document.getElementById('ib-title');
      const vignetteEl = document.getElementById('ib-vignette');
      const questionEl = document.getElementById('ib-question');

      if (badgeEl) badgeEl.innerText = `DILEMMA ${currentIceBreakerIndex + 1} OF ${ICE_BREAKER_DATA.length}`;
      if (topicEl) topicEl.innerText = d.topic;
      if (iconEl) iconEl.innerText = d.icon;
      if (titleEl) titleEl.innerText = d.title;
      if (vignetteEl) vignetteEl.innerText = d.vignette;
      if (questionEl) questionEl.innerText = d.question;

      renderIceBreakerPaginationDots();

      const choicesContainer = document.getElementById('ib-choices-container');
      if (choicesContainer) {
        choicesContainer.innerHTML = '';
        const letters = ['A', 'B'];

        d.choices.forEach((choice, cIdx) => {
          const btn = document.createElement('button');
          btn.onclick = () => selectIceBreakerChoice(cIdx);
          btn.id = `ib-choice-btn-${cIdx}`;
          btn.className = "p-4 sm:p-5 rounded-2xl border-2 border-slate-300 bg-white hover:border-teal-400 hover:bg-teal-50/50 text-left flex items-start gap-3 transition-all active:scale-98 shadow-sm group";
          btn.innerHTML = `
            <span class="w-8 h-8 rounded-xl bg-slate-100 group-hover:bg-teal-600 group-hover:text-white font-black text-sm flex items-center justify-center text-slate-800 transition flex-shrink-0 border border-slate-300">
              ${letters[cIdx]}
            </span>
            <span class="text-xs sm:text-sm font-bold text-slate-800 leading-snug pt-1">
              ${choice.text}
            </span>
          `;
          choicesContainer.appendChild(btn);
        });
      }

      const feedbackBox = document.getElementById('ib-feedback-box');
      if (feedbackBox) feedbackBox.classList.add('hidden');
      const ptsBadge = document.getElementById('ib-points-awarded-badge');
      if (ptsBadge) ptsBadge.classList.add('hidden');

      const awardContainer = document.getElementById('ib-team-award-buttons');
      if (awardContainer) {
        awardContainer.innerHTML = '';
        teams.forEach((t, tIdx) => {
          const tBtn = document.createElement('button');
          tBtn.onclick = () => awardIceBreakerPoints(tIdx);
          tBtn.className = "px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-cyan-700 text-white font-bold text-xs transition";
          tBtn.innerText = `+50 to ${t.name}`;
          awardContainer.appendChild(tBtn);
        });
      }
    }

    function renderIceBreakerPaginationDots() {
      const dotsContainer = document.getElementById('ib-dots-container');
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      ICE_BREAKER_DATA.forEach((item, idx) => {
        const dot = document.createElement('button');
        dot.onclick = () => { currentIceBreakerIndex = idx; renderIceBreakerCard(); };
        dot.className = `w-6 h-6 rounded-full text-[10px] font-black transition flex items-center justify-center ${
          idx === currentIceBreakerIndex
            ? 'bg-teal-700 text-white ring-2 ring-teal-400 shadow'
            : iceBreakerAnswered[idx]
              ? 'bg-emerald-200 text-emerald-900 border border-emerald-400'
              : 'bg-slate-200 text-slate-600 hover:bg-slate-300'
        }`;
        dot.innerText = idx + 1;
        dotsContainer.appendChild(dot);
      });
    }

    function selectIceBreakerChoice(choiceIdx) {
      const d = ICE_BREAKER_DATA[currentIceBreakerIndex];
      const selected = d.choices[choiceIdx];
      const feedbackBox = document.getElementById('ib-feedback-box');
      const feedbackIcon = document.getElementById('ib-feedback-icon');
      const feedbackTitle = document.getElementById('ib-feedback-title');
      const feedbackRationale = document.getElementById('ib-feedback-rationale');

      if (feedbackBox) feedbackBox.classList.remove('hidden');

      for (let i = 0; i < d.choices.length; i++) {
        const btn = document.getElementById(`ib-choice-btn-${i}`);
        if (btn) btn.disabled = true;
      }

      if (selected.correct) {
        sound.playEyeEnforcement();
        if (feedbackBox) feedbackBox.className = "p-4 sm:p-5 rounded-2xl border-2 border-emerald-500 bg-emerald-50 text-emerald-950 transition-all duration-300 shadow-md";
        if (feedbackIcon) feedbackIcon.innerText = "✅";
        if (feedbackTitle) feedbackTitle.innerText = "EXCELLENT CLINICAL RATIONALE! +50 POINTS";
        if (feedbackRationale) {
          feedbackRationale.innerHTML = `<strong>Correct Decision:</strong> ${d.rationale}<br><span class="text-[11px] text-emerald-800 italic mt-1.5 block">📚 Standard Reference: ${d.standardsRef}</span>`;
        }

        if (!iceBreakerAnswered[currentIceBreakerIndex]) {
          addScore(50);
          iceBreakerAnswered[currentIceBreakerIndex] = true;
          const badge = document.getElementById('ib-points-awarded-badge');
          if (badge) {
            badge.classList.remove('hidden');
            badge.innerText = `+50 Pts Awarded to ${teams[currentTeamIndex].name}!`;
          }
          showToast("🎉 Ice Breaker Correct! +50 Pts!", `${teams[currentTeamIndex].name} banked 50 points.`, "emerald");
        }
      } else {
        sound.playBigAlarm();
        triggerShake();
        if (feedbackBox) feedbackBox.className = "p-4 sm:p-5 rounded-2xl border-2 border-amber-500 bg-amber-50 text-amber-950 transition-all duration-300 shadow-md";
        if (feedbackIcon) feedbackIcon.innerText = "🚨";
        if (feedbackTitle) feedbackTitle.innerText = "CLINICAL TRAP IDENTIFIED — GROUP DISCUSSION";
        if (feedbackRationale) {
          feedbackRationale.innerHTML = `<strong>Infection Control Alert:</strong> That approach violates hospital transmission safeguards! <br><br><strong>Why:</strong> ${d.rationale}<br><span class="text-[11px] text-amber-800 italic mt-1.5 block">📚 Standard Reference: ${d.standardsRef}</span>`;
        }
        showToast("🚨 Clinical Dilemma Alert!", "Discuss the risk together as a team! Re-read the clinical rationale.", "amber");
      }

      renderIceBreakerPaginationDots();
    }

    function awardIceBreakerPoints(teamIdx) {
      teams[teamIdx].score += 50;
      updateScoreboardUI();
      renderTeamTabs();
      updateLeftMenuUI();
      sound.playLock();
      const badge = document.getElementById('ib-points-awarded-badge');
      if (badge) {
        badge.classList.remove('hidden');
        badge.innerText = `+50 Pts Awarded to ${teams[teamIdx].name}!`;
      }
      showToast(`+50 Pts Awarded!`, `Trainer awarded 50 points to ${teams[teamIdx].name}.`, "emerald");
    }

    function nextIceBreaker() {
      if (currentIceBreakerIndex < ICE_BREAKER_DATA.length - 1) {
        currentIceBreakerIndex++;
        renderIceBreakerCard();
      } else {
        showToast("All 8 Ice Breaker Dilemmas Completed! 🎯", "Click 'Ready for Main Puzzle' to start assembling the Chain of Infection!", "emerald");
      }
    }

    function prevIceBreaker() {
      if (currentIceBreakerIndex > 0) {
        currentIceBreakerIndex--;
        renderIceBreakerCard();
      }
    }

    // 5. SESSION ARCHIVE MANAGEMENT
    function archiveCurrentSession() {
      const activeGroup = teams[currentTeamIndex];
      const record = {
        id: Date.now(),
        date: new Date().toLocaleString(),
        groupName: activeGroup.name,
        score: activeGroup.score,
        stage1Complete: activeGroup.stage1Complete,
        brokenLinks: activeGroup.brokenLinks,
        allTeams: teams.map(t => ({ name: t.name, score: t.score, brokenLinks: t.brokenLinks }))
      };

      let history = [];
      try {
        history = JSON.parse(localStorage.getItem('ipc_training_archive') || '[]');
      } catch (e) { history = []; }

      history.unshift(record);
      localStorage.setItem('ipc_training_archive', JSON.stringify(history));

      renderArchiveList();
      showToast("Session Saved in Archive! 📁", `Saved results for ${activeGroup.name} (${activeGroup.score} pts).`, "emerald");
    }

    function renderArchiveList() {
      const container = document.getElementById('archive-list-container');
      if (!container) return;
      let history = [];
      try {
        history = JSON.parse(localStorage.getItem('ipc_training_archive') || '[]');
      } catch (e) { history = []; }

      if (history.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-slate-500 text-xs font-medium">
            No archived sessions yet. Click <strong>"Save in Archive"</strong> after running a group simulation.
          </div>
        `;
        return;
      }

      container.innerHTML = '';
      history.forEach((h) => {
        const item = document.createElement('div');
        item.className = 'p-3 rounded-2xl bg-slate-50 border border-slate-300 text-xs flex items-center justify-between gap-3';
        item.innerHTML = `
          <div>
            <div class="font-black text-slate-800 text-sm flex items-center gap-1.5">
              <span>👥</span> <span>${h.groupName}</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-800">${h.score} pts</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">
              ${h.date} • Stage 1: ${h.stage1Complete ? '✅ Assembled' : '⚡ Incomplete'} • ${h.brokenLinks}/10 Broken
            </div>
          </div>
          <button onclick="deleteArchiveItem(${h.id})" class="text-red-500 hover:text-red-700 font-bold px-2 py-1">
            🗑️
          </button>
        `;
        container.appendChild(item);
      });
    }

    function deleteArchiveItem(id) {
      let history = JSON.parse(localStorage.getItem('ipc_training_archive') || '[]');
      history = history.filter(h => h.id !== id);
      localStorage.setItem('ipc_training_archive', JSON.stringify(history));
      renderArchiveList();
    }

    function clearArchiveHistory() {
      if (confirm("Delete all archived sessions?")) {
        localStorage.removeItem('ipc_training_archive');
        renderArchiveList();
      }
    }

    // 6. STAGE 1: CHAIN LABELS RENDERING (BELOW BOARD)
    function renderChainPiecesBank() {
      const bank = document.getElementById('chain-pieces-bank');
      if (!bank) return;
      bank.innerHTML = '';
      
      shuffledChainLinks.forEach(link => {
        const isPlaced = boardSlots.includes(link.id);
        const card = document.createElement('div');
        card.id = `piece-${link.id}`;
        card.dataset.pieceId = link.id;
        card.dataset.type = 'chain-link';
        card.draggable = !isPlaced;

        card.className = `draggable-item p-3 rounded-2xl border-2 text-left flex flex-col justify-between transition-all duration-200 select-none ${
          isPlaced 
            ? 'opacity-30 pointer-events-none border-slate-200 bg-slate-100' 
            : selectedPieceId === link.id
              ? 'border-cyan-500 bg-cyan-50 text-cyan-900 ring-4 ring-cyan-400/50 scale-[1.02] shadow-md'
              : 'border-slate-300 bg-white hover:border-cyan-400 text-slate-800 shadow-sm hover:shadow'
        }`;

        card.innerHTML = `
          <div class="flex items-center justify-between mb-1">
            <div class="flex items-center gap-2">
              <span class="text-2xl">${link.icon}</span>
              <span class="font-extrabold text-xs sm:text-sm leading-tight text-slate-900">${link.name}</span>
            </div>
            <span class="text-[10px] font-black text-cyan-800 bg-cyan-100 px-2 py-0.5 rounded-md border border-cyan-300">
              Drag
            </span>
          </div>
          <p class="text-[10px] text-slate-500 line-clamp-1">${link.examples}</p>
        `;

        card.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', JSON.stringify({ type: 'chain-link', id: link.id }));
          card.classList.add('is-dragging');
          selectedPieceId = link.id;
        });
        card.addEventListener('dragend', () => card.classList.remove('is-dragging'));

        card.onclick = () => selectPiece(link.id);

        bank.appendChild(card);
      });
    }

    function selectPiece(linkId) {
      if (boardSlots.includes(linkId)) return;
      selectedPieceId = linkId;
      renderChainPiecesBank();
      const link = CHAIN_LINKS.find(l => l.id === linkId);
      showToast("Selected: " + link.name, "👆 Now tap any target circle on the board above to place it!", "cyan");
    }

    // 7. EXPANDED MAGNETIC DROP DETECTION
    function setupDropZones() {
      for (let i = 0; i < 6; i++) {
        const slotEl = document.getElementById(`node-${i}`);
        
        slotEl.addEventListener('dragover', (e) => {
          e.preventDefault();
          slotEl.classList.add('drag-over');
        });
        slotEl.addEventListener('dragenter', (e) => {
          e.preventDefault();
          slotEl.classList.add('drag-over');
        });
        slotEl.addEventListener('dragleave', () => {
          slotEl.classList.remove('drag-over');
        });

        slotEl.addEventListener('drop', (e) => {
          e.preventDefault();
          slotEl.classList.remove('drag-over');
          try {
            const rawData = e.dataTransfer.getData('text/plain');
            if (rawData) {
              const data = JSON.parse(rawData);
              if (data.type === 'chain-link') {
                handleLinkDropOnSlot(data.id, i);
              } else if (data.type === 'precaution') {
                handlePrecautionDropOnSlot(data.id, i);
              }
            }
          } catch (err) {}
        });

        slotEl.onclick = () => handleSlotClick(i);
      }

      const centerEl = document.getElementById('center-shield');
      centerEl.addEventListener('dragover', (e) => { e.preventDefault(); centerEl.classList.add('drag-over'); });
      centerEl.addEventListener('dragleave', () => centerEl.classList.remove('drag-over'));
      centerEl.addEventListener('drop', (e) => {
        e.preventDefault();
        centerEl.classList.remove('drag-over');
        try {
          const rawData = e.dataTransfer.getData('text/plain');
          if (rawData) {
            const data = JSON.parse(rawData);
            if (data.type === 'precaution') deployPrecaution(data.id);
          }
        } catch (err) {}
      });
    }

    function findClosestSlot(clientX, clientY) {
      let closestSlot = null;
      let minDistance = Infinity;

      for (let i = 0; i < 6; i++) {
        const node = document.getElementById(`node-${i}`);
        const nodeRect = node.getBoundingClientRect();
        const centerX = nodeRect.left + nodeRect.width / 2;
        const centerY = nodeRect.top + nodeRect.height / 2;
        const dist = Math.hypot(clientX - centerX, clientY - centerY);
        
        const threshold = Math.max(nodeRect.width * 0.9, 95);
        if (dist < threshold && dist < minDistance) {
          minDistance = dist;
          closestSlot = i;
        }
      }
      return closestSlot;
    }

    // 8. UNIFIED POINTER DRAG CONTROLLER
    function setupPointerDragSystem() {
      const ghost = document.getElementById('drag-ghost');
      const ghostIcon = document.getElementById('ghost-icon');
      const ghostName = document.getElementById('ghost-name');
      const ghostDesc = document.getElementById('ghost-desc');

      let activeDragData = null;
      let activeDragElement = null;
      let currentHoverSlot = null;

      window.addEventListener('pointermove', (e) => {
        if (!activeDragData) return;
        ghost.style.left = e.clientX + 'px';
        ghost.style.top = e.clientY + 'px';

        const closestSlotIndex = findClosestSlot(e.clientX, e.clientY);
        const slotEl = closestSlotIndex !== null ? document.getElementById(`node-${closestSlotIndex}`) : null;

        if (slotEl !== currentHoverSlot) {
          if (currentHoverSlot) currentHoverSlot.classList.remove('drag-over');
          if (slotEl) slotEl.classList.add('drag-over');
          currentHoverSlot = slotEl;
        }
      }, { passive: false });

      window.addEventListener('pointerup', (e) => {
        if (!activeDragData) return;
        ghost.style.display = 'none';

        const closestSlotIndex = findClosestSlot(e.clientX, e.clientY);

        if (currentHoverSlot) currentHoverSlot.classList.remove('drag-over');

        if (closestSlotIndex !== null) {
          if (activeDragData.type === 'chain-link') {
            handleLinkDropOnSlot(activeDragData.id, closestSlotIndex);
          } else if (activeDragData.type === 'precaution') {
            handlePrecautionDropOnSlot(activeDragData.id, closestSlotIndex);
          }
        }

        if (activeDragElement) activeDragElement.classList.remove('is-dragging');
        activeDragData = null;
        activeDragElement = null;
        currentHoverSlot = null;
      });

      document.addEventListener('pointerdown', (e) => {
        const item = e.target.closest('.draggable-item');
        if (!item) return;

        const pieceId = item.dataset.pieceId;
        const precId = item.dataset.precautionId;
        const type = item.dataset.type;

        if (type === 'chain-link' && pieceId !== undefined) {
          const id = parseInt(pieceId);
          if (boardSlots.includes(id)) return;
          const link = CHAIN_LINKS.find(l => l.id === id);
          if (!link) return;

          activeDragData = { type: 'chain-link', id: id };
          activeDragElement = item;
          item.classList.add('is-dragging');

          ghostIcon.innerText = link.icon;
          ghostName.innerText = link.shortName;
          ghostDesc.innerText = "Drop into correct position";
          ghost.style.left = e.clientX + 'px';
          ghost.style.top = e.clientY + 'px';
          ghost.style.display = 'flex';
        } else if (type === 'precaution' && precId) {
          const prec = STANDARD_PRECAUTIONS.find(p => p.id === precId);
          if (!prec) return;

          activeDragData = { type: 'precaution', id: precId };
          activeDragElement = item;
          item.classList.add('is-dragging');

          ghostIcon.innerText = prec.icon;
          ghostName.innerText = prec.name;
          ghostDesc.innerText = "Drop on targeted link to break!";
          ghost.style.left = e.clientX + 'px';
          ghost.style.top = e.clientY + 'px';
          ghost.style.display = 'flex';
        }
      });
    }

    // 9. LOGIC: LINK DROP & CLICK HANDLING
    function handleLinkDropOnSlot(linkId, slotIndex) {
      if (currentStage !== 1) return;

      if (linkId === slotIndex) {
        boardSlots[slotIndex] = linkId;
        const link = CHAIN_LINKS[linkId];
        fillSlotUI(slotIndex, link);
        
        sound.playEyeEnforcement();
        triggerEyeEnforcementUI(slotIndex);
        addScore(100);

        showToast(`Correct! Position ${slotIndex + 1}: ${link.name}`, `👁️ Eye & Sound Enforcement: Link secured! +100 pts for ${teams[currentTeamIndex].name}!`, 'emerald');
        selectedPieceId = null;
        renderChainPiecesBank();
        checkStage1Completion();
      } else {
        triggerBigAlarm();
        teams[currentTeamIndex].wrongCount++;
      }
    }

    function handleSlotClick(slotIndex) {
      if (currentStage === 1) {
        if (selectedPieceId === null) {
          showToast("Select a Chain Label Below", "Click one of the labels below, then tap here to place it.", "amber");
          sound.playLock();
          return;
        }
        handleLinkDropOnSlot(selectedPieceId, slotIndex);
      } else {
        const scenario = CLINICAL_SCENARIOS[currentScenarioIndex];
        if (slotIndex === scenario.targetNode) {
          showToast("Target Transmission Link", "Select or drag the matching Standard Precaution from below!", "cyan");
        }
      }
    }

    function handleCenterZoneClick() {
      if (currentStage === 2) {
        showToast("Standard Precautions Hub", "Select or drag the correct precaution from below to shatter the link!", "cyan");
      }
    }

    function fillSlotUI(slotIndex, link) {
      const node = document.getElementById(`node-${slotIndex}`);
      node.classList.remove('border-dashed', 'border-cyan-700');
      node.classList.add('border-solid', 'border-cyan-600', 'bg-cyan-700', 'text-white', 'shadow-lg');
      node.innerHTML = `
        <span class="text-base sm:text-xl md:text-2xl mb-0.5 leading-none">${link.icon}</span>
        <span class="text-[9px] sm:text-[10px] md:text-xs font-black leading-tight text-white">${link.shortName}</span>
      `;
    }

    function triggerEyeEnforcementUI(slotIndex) {
      const node = document.getElementById(`node-${slotIndex}`);
      
      const eyeBadge = document.createElement('div');
      eyeBadge.className = 'absolute -top-2.5 -right-2.5 bg-emerald-600 text-white text-[10px] font-black px-2 py-0.5 rounded-full shadow-lg border-2 border-white flex items-center gap-1 eye-beacon z-30';
      eyeBadge.innerHTML = '<span>👁️</span><span>SECURED</span>';
      node.appendChild(eyeBadge);

      node.classList.add('ring-4', 'ring-emerald-400', 'ring-offset-2');
      setTimeout(() => {
        node.classList.remove('ring-4', 'ring-emerald-400', 'ring-offset-2');
      }, 2000);
    }

    function triggerBigAlarm() {
      sound.playBigAlarm();
      triggerShake();

      const root = document.getElementById('body-root');
      root.classList.add('alarm-flash');
      setTimeout(() => root.classList.remove('alarm-flash'), 1600);

      const banner = document.getElementById('big-alarm-banner');
      banner.classList.remove('-translate-y-24', 'opacity-0', 'pointer-events-none');
      banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');

      clearTimeout(window.alarmTimer);
      window.alarmTimer = setTimeout(hideBigAlarm, 4500);
    }

    function hideBigAlarm() {
      const banner = document.getElementById('big-alarm-banner');
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('-translate-y-24', 'opacity-0', 'pointer-events-none');
    }

    function autoSolveStage1() {
      CHAIN_LINKS.forEach((link, idx) => {
        boardSlots[idx] = idx;
        fillSlotUI(idx, link);
      });
      renderChainPiecesBank();
      checkStage1Completion();
    }

    function checkStage1Completion() {
      const allFilled = boardSlots.every((s, idx) => s === idx);
      if (allFilled) {
        sound.playVictory();
        teams[currentTeamIndex].stage1Complete = true;

        document.getElementById('stage1-complete-box').classList.remove('hidden');
        document.getElementById('stage1-panel').classList.add('hidden');

        updateLeftMenuUI();
        showToast("🎉 CHAIN FULLY ASSEMBLED! 🎉", "Review order together, then click the button below to proceed to Stage 2!", "emerald");
      }
    }

    // 10. STAGE 2: BREAK THE CHAIN
    function activateStage2() {
      currentStage = 2;
      document.getElementById('stage1-complete-box').classList.add('hidden');
      document.getElementById('stage1-panel').classList.add('hidden');
      document.getElementById('stage2-panel').classList.remove('hidden');
      document.getElementById('stage2-panel').classList.add('flex');
      
      document.getElementById('stage-badge').innerText = "STAGE 2: BREAK THE CHAIN!";
      document.getElementById('stage-badge').className = "px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-sm";
      document.getElementById('stage-desc').innerText = "Deploy Standard Precautions against clinical infection cycles!";

      document.getElementById('chain-status-text').innerText = "TARGET READY TO SHATTER!";
      document.getElementById('chain-status-text').className = "mt-1 text-[8px] sm:text-[9px] text-emerald-800 font-bold px-2 py-0.5 rounded-full bg-emerald-100";
      
      shuffleStage2Choices();
      renderPrecautionsGrid();
      loadScenario(0);
      updateLeftMenuUI();
      showToast("STAGE 2 ACTIVE! 💥", "Match Standard Precautions from below to shatter transmission links!", "emerald");
    }

    function renderPrecautionsGrid() {
      const grid = document.getElementById('precautions-grid');
      if (!grid) return;
      grid.innerHTML = '';
      shuffledPrecautions.forEach(p => {
        const btn = document.createElement('div');
        btn.id = `prec-${p.id}`;
        btn.dataset.precautionId = p.id;
        btn.dataset.type = 'precaution';
        btn.draggable = true;

        btn.className = 'draggable-item p-2.5 rounded-2xl border-2 border-slate-300 bg-white hover:bg-emerald-50 hover:border-emerald-400 text-left flex items-center justify-between gap-2 transition active:scale-95 group shadow-sm cursor-grab select-none';
        
        btn.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="text-xl group-hover:scale-110 transition-transform">${p.icon}</span>
            <span class="text-[11px] sm:text-xs font-bold text-slate-900 group-hover:text-emerald-800 leading-snug">${p.name}</span>
          </div>
          <span class="text-[9px] font-black text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md border border-emerald-300 flex-shrink-0">
            Use
          </span>
        `;

        btn.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', JSON.stringify({ type: 'precaution', id: p.id }));
          btn.classList.add('is-dragging');
        });
        btn.addEventListener('dragend', () => btn.classList.remove('is-dragging'));

        btn.onclick = () => deployPrecaution(p.id);

        grid.appendChild(btn);
      });
    }

    function loadScenario(index) {
      if (index >= CLINICAL_SCENARIOS.length) {
        finishSession();
        return;
      }
      currentScenarioIndex = index;
      const s = CLINICAL_SCENARIOS[index];
      document.getElementById('scenario-num').innerText = `Scenario ${index + 1} of ${CLINICAL_SCENARIOS.length}`;
      document.getElementById('scenario-question').innerText = s.question;
      document.getElementById('scenario-hint').innerText = "💡 Key IPC Clue: " + s.hint;

      const targetLink = CHAIN_LINKS[s.targetNode];
      document.getElementById('scenario-target-badge').innerText = `Target Link: ${targetLink.name}`;
      
      for (let i = 0; i < 6; i++) {
        const node = document.getElementById(`node-${i}`);
        if (i === s.targetNode) {
          node.classList.add('ring-4', 'ring-amber-400', 'ring-offset-2');
        } else {
          node.classList.remove('ring-4', 'ring-amber-400', 'ring-offset-2');
        }
      }
    }

    function handlePrecautionDropOnSlot(precautionId, slotIndex) {
      const scenario = CLINICAL_SCENARIOS[currentScenarioIndex];
      if (slotIndex === scenario.targetNode) {
        deployPrecaution(precautionId);
      } else {
        triggerBigAlarm();
        showToast("Incorrect Target Node", `Scenario is targeting: ${CHAIN_LINKS[scenario.targetNode].name}. Discuss as a group!`, "amber");
      }
    }

    function deployPrecaution(precautionId) {
      const scenario = CLINICAL_SCENARIOS[currentScenarioIndex];
      const precaution = STANDARD_PRECAUTIONS.find(p => p.id === precautionId);
      
      const isCorrect = (precautionId === scenario.correctId) || precaution.breaks.includes(scenario.targetNode);

      if (isCorrect) {
        sound.playGlassBreak();
        sound.playEyeEnforcement();
        triggerShake();
        createShardParticles(scenario.targetNode);

        const node = document.getElementById(`node-${scenario.targetNode}`);
        node.classList.add('shattered-node');
        node.innerHTML = `
          <span class="text-base sm:text-xl">💥🔗</span>
          <span class="text-[9px] sm:text-[10px] font-black text-white uppercase leading-none">BROKEN!</span>
          <span class="text-[8px] text-white/95 font-bold mt-0.5 line-clamp-1">${precaution.name}</span>
        `;

        brokenLinksSet.add(scenario.targetNode);
        teams[currentTeamIndex].brokenLinks = brokenLinksSet.size;
        teams[currentTeamIndex].correctCount++;
        addScore(150);

        document.getElementById('break-count').innerText = `${currentScenarioIndex + 1} / ${CLINICAL_SCENARIOS.length} Broken`;
        showToast("💥 CRACK! CHAIN LINK SHATTERED! 💥", `👁️ Eye & Sound Enforcement: ${scenario.rationale}`, "emerald");

        document.getElementById('center-icon').innerText = '🛡️💥';
        document.getElementById('center-shield').classList.add('border-emerald-500', 'shadow-emerald-500/40');

        setTimeout(() => {
          loadScenario(currentScenarioIndex + 1);
        }, 1600);

      } else {
        triggerBigAlarm();
        teams[currentTeamIndex].wrongCount++;
      }
    }

    function createShardParticles(targetNodeIndex) {
      const node = document.getElementById(`node-${targetNodeIndex}`);
      const parent = document.getElementById('board-aspect-box');
      const rect = node.getBoundingClientRect();
      const parentRect = parent.getBoundingClientRect();

      const originX = rect.left + rect.width / 2 - parentRect.left;
      const originY = rect.top + rect.height / 2 - parentRect.top;

      for (let i = 0; i < 20; i++) {
        const shard = document.createElement('div');
        shard.className = i % 3 === 0 ? 'particle spark-shard' : 'particle glass-shard';
        const size = Math.floor(Math.random() * 14) + 6;
        shard.style.width = size + 'px';
        shard.style.height = size + 'px';
        shard.style.left = originX + 'px';
        shard.style.top = originY + 'px';

        const angle = Math.random() * Math.PI * 2;
        const dist = Math.random() * 180 + 40;
        const tx = Math.cos(angle) * dist + 'px';
        const ty = Math.sin(angle) * dist + 'px';
        const rot = (Math.random() * 720 - 360) + 'deg';

        shard.style.setProperty('--tx', tx);
        shard.style.setProperty('--ty', ty);
        shard.style.setProperty('--rot', rot);

        parent.appendChild(shard);
        setTimeout(() => shard.remove(), 750);
      }
    }

    function triggerShake() {
      const board = document.getElementById('board-aspect-box');
      board.classList.remove('shake-active');
      void board.offsetWidth;
      board.classList.add('shake-active');
      setTimeout(() => board.classList.remove('shake-active'), 500);
    }

    // 11. TOAST FEEDBACK
    function showToast(title, desc, color) {
      const toast = document.getElementById('shatter-toast');
      const titleEl = document.getElementById('toast-title');
      const descEl = document.getElementById('toast-desc');

      titleEl.innerText = title;
      descEl.innerText = desc;

      if (color === 'emerald') {
        titleEl.className = "font-black text-xs sm:text-sm text-emerald-400 uppercase tracking-wide";
        toast.className = "w-full max-w-[900px] mt-3 p-3 rounded-2xl bg-emerald-950 text-white border border-emerald-500/50 text-center transition-all opacity-100 transform translate-y-0 shadow-lg shadow-emerald-500/20";
      } else if (color === 'red') {
        titleEl.className = "font-black text-xs sm:text-sm text-red-400 uppercase tracking-wide";
        toast.className = "w-full max-w-[900px] mt-3 p-3 rounded-2xl bg-red-950 text-white border border-red-500/50 text-center transition-all opacity-100 transform translate-y-0 shadow-lg shadow-red-500/20";
      } else if (color === 'cyan') {
        titleEl.className = "font-black text-xs sm:text-sm text-cyan-400 uppercase tracking-wide";
        toast.className = "w-full max-w-[900px] mt-3 p-3 rounded-2xl bg-cyan-950 text-white border border-cyan-500/50 text-center transition-all opacity-100 transform translate-y-0 shadow-lg shadow-cyan-500/20";
      } else {
        titleEl.className = "font-black text-xs sm:text-sm text-amber-400 uppercase tracking-wide";
        toast.className = "w-full max-w-[900px] mt-3 p-3 rounded-2xl bg-amber-950 text-white border border-amber-500/50 text-center transition-all opacity-100 transform translate-y-0 shadow-lg shadow-amber-500/20";
      }

      clearTimeout(window.toastTimer);
      window.toastTimer = setTimeout(() => {
        toast.className = "w-full max-w-[900px] mt-3 p-3 rounded-2xl bg-slate-900 text-white text-center transition-all opacity-0 pointer-events-none transform translate-y-2";
      }, 5000);
    }

    // 12. TIMER CONTROLS
    function toggleTimer() {
      const btn = document.getElementById('btn-timer-toggle');
      if (isTimerRunning) {
        clearInterval(timerInterval);
        isTimerRunning = false;
        btn.innerText = "▶ Resume";
        btn.className = "px-3.5 py-1.5 text-xs font-black rounded-xl bg-cyan-700 hover:bg-cyan-600 text-white transition active:scale-95 shadow flex items-center gap-1";
      } else {
        sound.init();
        isTimerRunning = true;
        btn.innerText = "⏸ Pause";
        btn.className = "px-3.5 py-1.5 text-xs font-black rounded-xl bg-amber-600 hover:bg-amber-500 text-white transition active:scale-95 shadow flex items-center gap-1";
        
        timerInterval = setInterval(() => {
          if (totalSeconds > 0) {
            totalSeconds--;
            updateTimerDisplay();
            if (totalSeconds <= 10) sound.playTick();
          } else {
            clearInterval(timerInterval);
            isTimerRunning = false;
            sound.playVictory();
            finishSession();
          }
        }, 1000);
      }
    }

    function resetTimer() {
      clearInterval(timerInterval);
      isTimerRunning = false;
      totalSeconds = sessionSeconds;
      const btn = document.getElementById('btn-timer-toggle');
      btn.innerText = "▶ Start";
      btn.className = "px-3.5 py-1.5 text-xs font-black rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white transition active:scale-95 shadow flex items-center gap-1";
      updateTimerDisplay();
    }

    function setTimerMinutes(mins) {
      sessionSeconds = mins * 60;
      resetTimer();
      showToast(`Timer Set to ${mins} Minutes`, "Ready to start simulation countdown.", "cyan");
      updatePMUI();
    }

    function updateTimerDisplay() {
      const mins = Math.floor(totalSeconds / 60);
      const secs = totalSeconds % 60;
      const formatted = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      
      const el = document.getElementById('timer-display');
      el.innerText = formatted;

      if (totalSeconds <= 60 && totalSeconds > 10) {
        el.className = "font-mono text-2xl sm:text-3xl font-black text-amber-400 animate-pulse leading-none";
      } else if (totalSeconds <= 10) {
        el.className = "font-mono text-2xl sm:text-3xl font-black text-red-500 animate-bounce leading-none";
      } else {
        el.className = "font-mono text-2xl sm:text-3xl font-black text-cyan-300 leading-none";
      }
    }

    function toggleSound() {
      const enabled = sound.toggle();
      showToast(enabled ? "Sound FX Enabled" : "Sound Muted", "", "cyan");
      updatePMUI();
    }

    function updatePMUI() {
      const pmSoundBtn = document.getElementById('pm-sound-btn');
      if (pmSoundBtn) {
        pmSoundBtn.innerText = sound.enabled ? '🔊' : '🔇';
        pmSoundBtn.className = sound.enabled 
          ? "w-12 h-12 rounded-2xl bg-slate-900 border-2 border-cyan-400 text-cyan-300 flex items-center justify-center text-2xl transition active:scale-95 shadow-md shadow-cyan-500/20"
          : "w-12 h-12 rounded-2xl bg-slate-900 border-2 border-slate-700 text-slate-500 flex items-center justify-center text-2xl transition active:scale-95 shadow-md";
      }
      const hdrSoundBtn = document.getElementById('hdr-sound-btn');
      if (hdrSoundBtn) {
        hdrSoundBtn.innerText = sound.enabled ? '🔊' : '🔇';
        hdrSoundBtn.className = sound.enabled
          ? "w-10 h-10 rounded-xl bg-[#03152c] border-2 border-cyan-400 text-cyan-300 flex items-center justify-center text-lg transition active:scale-95 shadow shadow-cyan-500/20"
          : "w-10 h-10 rounded-xl bg-[#03152c] border-2 border-slate-700 text-slate-500 flex items-center justify-center text-lg transition active:scale-95 shadow";
      }
      const pmTimerLabel = document.getElementById('pm-timer-label');
      if (pmTimerLabel) {
        pmTimerLabel.innerText = `${Math.floor(sessionSeconds / 60)}:00 (${sessionSeconds / 60} min)`;
      }
      const pmSquads = document.getElementById('pm-squads-count');
      if (pmSquads) {
        pmSquads.innerText = `${teams.length} Active Groups`;
      }
    }

    function toggleBoardBackground() {
      const img = document.getElementById('template-bg-img');
      const svg = document.getElementById('svg-board-canvas');
      const label = document.getElementById('bg-mode-label');

      if (boardViewMode === 'template') {
        boardViewMode = 'svg';
        img.style.opacity = '0';
        svg.style.opacity = '1';
        label.innerText = 'Vector View';
      } else {
        boardViewMode = 'template';
        img.style.opacity = '1';
        svg.style.opacity = '0';
        label.innerText = 'Template View';
      }
    }

    function handleImageFallback(img) {
      img.style.display = 'none';
      document.getElementById('svg-board-canvas').style.opacity = '1';
      document.getElementById('bg-mode-label').innerText = 'Vector Mode';
    }

    function toggleFullScreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().then(() => {
          enableShrinkFitMode();
        }).catch(err => {
          enableShrinkFitMode();
        });
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
      }
    }

    // 13. CSV EXPORT & RESULTS
    function exportScoresCSV() {
      let csv = "Rank,Group Name,Score,Chain Assembled,Broken Links,Correct Answers,Errors\n";
      const sorted = [...teams].sort((a, b) => b.score - a.score);
      sorted.forEach((t, i) => {
        csv += `${i + 1},"${t.name}",${t.score},${t.stage1Complete ? "Yes" : "No"},${t.brokenLinks},${t.correctCount},${t.wrongCount}\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `IPC_Simulation_Scores_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("Scores Exported", "Downloaded CSV report for hospital training records.", "emerald");
    }

    function finishSession() {
      sound.playVictory();
      clearInterval(timerInterval);

      const sorted = [...teams].sort((a, b) => b.score - a.score);
      const winner = sorted[0];

      document.getElementById('winner-team-name').innerText = winner.name;
      const timeSpentSec = sessionSeconds - totalSeconds;
      const spentMin = Math.floor(timeSpentSec / 60);
      const spentSec = timeSpentSec % 60;
      document.getElementById('winner-stats').innerText = `🏆 1st Place with ${winner.score} Points • ${winner.brokenLinks}/6 Chain Links Shattered • Completed in ${spentMin}m ${spentSec}s`;

      const tbody = document.getElementById('results-table-body');
      tbody.innerHTML = '';
      sorted.forEach((t, i) => {
        const tr = document.createElement('tr');
        const rankMedal = i === 0 ? '🥇 1st' : i === 1 ? '🥈 2nd' : i === 2 ? '🥉 3rd' : `${i + 1}th`;
        tr.className = i === 0 ? 'bg-amber-100 font-bold' : '';
        tr.innerHTML = `
          <td class="p-3">${rankMedal}</td>
          <td class="p-3 flex items-center gap-2">
            <span>${i === 0 ? '👑' : '👥'}</span>
            <span>${t.name}</span>
          </td>
          <td class="p-3 text-center">${t.stage1Complete ? '✅ Assembled' : '⚡ Partial'}</td>
          <td class="p-3 text-center"><span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">${t.brokenLinks} Links</span></td>
          <td class="p-3 text-right font-mono font-black text-cyan-800">${t.score}</td>
        `;
        tbody.appendChild(tr);
      });

      openModal('results-modal');
    }

    function showCertificate() {
      const sorted = [...teams].sort((a, b) => b.score - a.score);
      const winner = sorted[0];
      document.getElementById('cert-team-name').innerText = winner.name;
      openModal('certificate-modal');
    }

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    function restartFullGame() {
      closeModal('results-modal');
      closeModal('certificate-modal');
      teams.forEach(t => {
        t.score = 0;
        t.stage1Complete = false;
        t.brokenLinks = 0;
        t.correctCount = 0;
        t.wrongCount = 0;
      });
      iceBreakerAnswered = [false, false, false, false, false, false, false, false];
      currentIceBreakerIndex = 0;
      renderIceBreakerCard();
      resetCurrentGame();
      resetTimer();
    }

    function resetCurrentGame() {
      shuffleStage1Choices();
      shuffleStage2Choices();
      boardSlots = [null, null, null, null, null, null];
      selectedPieceId = null;
      currentStage = 1;
      currentScenarioIndex = 0;
      brokenLinksSet.clear();

      for (let i = 0; i < 6; i++) {
        const node = document.getElementById(`node-${i}`);
        node.className = "circle-slot border-2 border-dashed border-cyan-700 bg-white/85 shadow-md";
        if (i === 0) { node.style.top = "28.8%"; node.style.left = "49.8%"; }
        if (i === 1) { node.style.top = "39.9%"; node.style.left = "70.2%"; }
        if (i === 2) { node.style.top = "71.9%"; node.style.left = "70.3%"; }
        if (i === 3) { node.style.top = "86.3%"; node.style.left = "49.8%"; }
        if (i === 4) { node.style.top = "71.9%"; node.style.left = "29.5%"; }
        if (i === 5) { node.style.top = "39.8%"; node.style.left = "29.3%"; }

        const link = CHAIN_LINKS[i];
        node.innerHTML = `
          <span class="text-[10px] sm:text-xs font-black text-cyan-900 leading-tight">Position ${i + 1}</span>
          <span class="slot-placeholder text-[8px] sm:text-[10px] text-slate-500 font-semibold">Drop ${link.shortName}</span>
        `;
      }

      document.getElementById('stage1-complete-box').classList.add('hidden');
      document.getElementById('stage1-panel').classList.remove('hidden');
      document.getElementById('stage2-panel').classList.add('hidden');
      document.getElementById('stage2-panel').classList.remove('flex');
      
      document.getElementById('stage-badge').innerText = "STAGE 1: ASSEMBLE CHAIN";
      document.getElementById('stage-badge').className = "px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-cyan-100 text-cyan-800 border border-cyan-300 shadow-sm";
      document.getElementById('stage-desc').innerText = "Drag or tap labels from below into the 6 empty circular positions in clockwise order.";

      document.getElementById('center-icon').innerText = '🔗💥';
      document.getElementById('center-shield').className = "circle-slot !w-[22%] !aspect-square !top-[59.9%] !left-[49.8%] bg-white/95 border-2 border-cyan-500 shadow-xl backdrop-blur-sm z-30 flex flex-col items-center justify-center text-center p-1.5 transition-all duration-300";
      document.getElementById('chain-status-text').innerText = "6 Links Active";
      document.getElementById('chain-status-text').className = "mt-1 text-[8px] sm:text-[9px] text-amber-800 font-bold px-2 py-0.5 rounded-full bg-amber-100 leading-tight";

      renderChainPiecesBank();
      renderTeamTabs();
      showToast("Round Reset", "Ready for training session!", "cyan");
    }
  </script>

</body>
</html>
