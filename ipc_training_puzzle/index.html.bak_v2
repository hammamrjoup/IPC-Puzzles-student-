          <p class="text-xs text-slate-500 mb-3">Interactive whiteboard and lecture hall options:</p>
          <div class="flex items-center gap-2">
            <button onclick="toggleBoardBackground()" class="flex-1 py-2 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 font-bold text-xs transition flex items-center justify-center gap-1.5">
