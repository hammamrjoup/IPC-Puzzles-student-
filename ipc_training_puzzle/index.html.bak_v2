<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>IPC Chain Breaker — Hospital IPC Training</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>

  <style>
    /* Eye-Comfortable Muted Palette (Zero Shiny Glare) */
    body {
      background-color: #e5ebf1;
      color: #1e293b;
    }

    /* Custom Keyframes & Animations */
    @keyframes shatterPulse {
      0% { transform: translate(-50%, -50%) scale(1); filter: brightness(1); }
      40% { transform: translate(-50%, -50%) scale(1.18); filter: brightness(1.7) drop-shadow(0 0 25px rgba(16, 185, 129, 0.95)); }
      100% { transform: translate(-50%, -50%) scale(1); filter: brightness(1); }
    }
    @keyframes screenShake {
      0%, 100% { transform: translate(0, 0); }
      15% { transform: translate(-8px, 5px) rotate(-0.7deg); }
      30% { transform: translate(8px, -5px) rotate(0.7deg); }
      45% { transform: translate(-6px, -4px); }
      60% { transform: translate(6px, 4px); }
      75% { transform: translate(-3px, 2px); }
    }
    @keyframes redAlarmFlash {
      0%, 100% { box-shadow: inset 0 0 0 0 rgba(239, 68, 68, 0); }
      50% { box-shadow: inset 0 0 0 8px rgba(239, 68, 68, 0.8), 0 0 35px rgba(239, 68, 68, 0.6); }
    }
    @keyframes eyeBeaconPulse {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      50% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    }
    @keyframes particleBurst {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)) scale(0) rotate(var(--rot)); opacity: 0; }
    }

    .shake-active {
      animation: screenShake 0.48s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }
    .alarm-flash {
      animation: redAlarmFlash 0.5s ease-in-out 3;
    }
    .shattered-node {
      animation: shatterPulse 0.65s ease-out forwards;
      border-color: #059669 !important;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.95) 0%, rgba(5, 150, 105, 0.9) 100%) !important;
      box-shadow: 0 0 25px rgba(16, 185, 129, 0.8), inset 0 0 15px rgba(255, 255, 255, 0.5) !important;
      color: white !important;
    }
    .eye-beacon {
      animation: eyeBeaconPulse 1.4s infinite;
    }
    .particle {
      position: absolute;
      pointer-events: none;
      z-index: 60;
      animation: particleBurst 0.75s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }
    .glass-shard {
      clip-path: polygon(50% 0%, 100% 70%, 75% 100%, 0% 80%, 20% 20%);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(45, 212, 191, 0.85));
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
    }
    .spark-shard {
      border-radius: 50%;
      background: #fbbf24;
      box-shadow: 0 0 10px #f59e0b;
    }

    /* Board Circular Slots Position & Magnetic Hitbox (Aligned with template.jpg) */
    .circle-slot {
      position: absolute;
      transform: translate(-50%, -50%);
      width: 15.2%;
      aspect-ratio: 1 / 1;
      border-radius: 9999px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      cursor: pointer;
      user-select: none;
      touch-action: none;
      transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 20;
    }
    .circle-slot:hover {
      transform: translate(-50%, -50%) scale(1.06);
    }
    .circle-slot.drag-over {
      transform: translate(-50%, -50%) scale(1.14);
      border-color: #06b6d4 !important;
      box-shadow: 0 0 0 6px rgba(6, 182, 212, 0.5), 0 0 25px rgba(6, 182, 212, 0.8) !important;
      background-color: rgba(6, 182, 212, 0.25) !important;
    }

    /* Floating Drag Ghost for Touch & Mouse */
    #drag-ghost {
      position: fixed;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 0.95;
      display: none;
      box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.4), 0 0 0 3px #06b6d4;
      border-radius: 1.25rem;
    }

    /* Draggable Item States */
    .draggable-item {
      cursor: grab;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
    }
    .draggable-item:active {
      cursor: grabbing;
    }
    .draggable-item.is-dragging {
      opacity: 0.35;
      transform: scale(0.96);
    }

    /* Printable certificate rules */
    @media print {
      body * {
        visibility: hidden;
      }
      #certificate-modal, #certificate-modal * {
        visibility: visible;
      }
      #certificate-modal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        background: white !important;
        color: black !important;
      }
      .no-print {
        display: none !important;
      }
    }

    /* ========================================================== */
    /* 📐 SHRINK TO FIT FULL PAGE PRESENTATION MODE STYLING 📐   */
    /* ========================================================== */
    body.shrink-fit-active {
      overflow: hidden !important;
      height: 100vh !important;
      max-height: 100vh !important;
    }

    body.shrink-fit-active #app {
      height: 100vh !important;
      max-height: 100vh !important;
      padding: 0.35rem 0.6rem !important;
      gap: 0.35rem !important;
      overflow: hidden !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
    }

    /* Top Header Bar in Shrink-Fit Mode */
    body.shrink-fit-active #main-header {
      padding: 0.4rem 0.75rem !important;
      border-radius: 1.25rem !important;
      margin-bottom: 0 !important;
      flex-shrink: 0 !important;
    }

    body.shrink-fit-active #main-header-row {
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 0.75rem !important;
      width: 100% !important;
    }

    body.shrink-fit-active #header-left-col {
      display: flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      max-width: none !important;
      flex-shrink: 0 !important;
    }

    body.shrink-fit-active #header-logo-card {
      padding: 0.2rem !important;
      border-radius: 0.75rem !important;
      border-width: 2px !important;
      max-width: none !important;
    }

    body.shrink-fit-active #header-logo-img {
      width: 2.5rem !important;
      height: 2.5rem !important;
    }

    body.shrink-fit-active #header-logo-details {
      display: none !important;
    }

    body.shrink-fit-active #header-badge-pill {
      margin-bottom: 0 !important;
    }

    body.shrink-fit-active #header-badge-pill div {
      padding: 0.15rem 0.5rem !important;
    }

    body.shrink-fit-active #header-badge-pill span {
      font-size: 0.65rem !important;
    }

    body.shrink-fit-active #header-title-box {
      gap: 0.35rem !important;
    }

    body.shrink-fit-active #header-title-box svg {
      width: 1.75rem !important;
      height: 1.75rem !important;
    }

    body.shrink-fit-active #header-title-box h1 {
      font-size: 1.15rem !important;
      letter-spacing: normal !important;
    }

    body.shrink-fit-active #header-subtitle {
      display: none !important;
    }

    body.shrink-fit-active #header-attribution {
      display: none !important;
    }

    body.shrink-fit-active #header-divider {
      display: none !important;
    }

    body.shrink-fit-active #header-controls-row {
      margin-top: 0 !important;
      gap: 0.4rem !important;
      flex-wrap: nowrap !important;
    }

    body.shrink-fit-active #timer-box {
      padding: 0.25rem 0.6rem !important;
      border-radius: 0.75rem !important;
      gap: 0.4rem !important;
    }

    body.shrink-fit-active #timer-display {
      font-size: 1.25rem !important;
    }

    body.shrink-fit-active #squads-bar {
      display: none !important;
    }

    body.shrink-fit-active footer {
      display: none !important;
    }

    /* Left Menu Slide-Over Drawer in Shrink-Fit Mode */
    body.shrink-fit-active #left-nav-menu {
      position: fixed !important;
      left: 0 !important;
      top: 0 !important;
      bottom: 0 !important;
      z-index: 90 !important;
      width: 20rem !important;
      max-width: 85vw !important;
      height: 100vh !important;
      transform: translateX(-105%) !important;
      transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
      background: #021329 !important;
      padding: 1rem !important;
      box-shadow: 10px 0 35px rgba(0, 0, 0, 0.8) !important;
      overflow-y: auto !important;
    }

    body.shrink-fit-active #left-nav-menu.drawer-open {
      transform: translateX(0) !important;
    }

    /* Board & Choices Area in Shrink-Fit Mode */
    body.shrink-fit-active #view-puzzle {
      gap: 0.35rem !important;
      height: calc(100vh - 4.5rem) !important;
      max-height: calc(100vh - 4.5rem) !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      width: 100% !important;
      overflow: hidden !important;
    }

    body.shrink-fit-active #board-card {
      padding: 0.35rem 0.6rem !important;
      border-radius: 1.25rem !important;
      flex: 1 1 auto !important;
      min-height: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      margin-bottom: 0 !important;
    }

    body.shrink-fit-active #board-card-header {
      margin-bottom: 0.2rem !important;
      padding-bottom: 0.2rem !important;
    }

    body.shrink-fit-active #board-aspect-box {
      max-height: 47vh !important;
      height: 47vh !important;
      width: auto !important;
      aspect-ratio: 1024 / 576 !important;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08) !important;
    }

    body.shrink-fit-active #shatter-toast {
      margin-top: 0.2rem !important;
      padding: 0.35rem !important;
    }

    body.shrink-fit-active #puzzle-choices-container {
      flex-shrink: 0 !important;
      width: 100% !important;
      max-width: 900px !important;
    }

    body.shrink-fit-active #stage1-panel {
      padding: 0.4rem 0.6rem !important;
      border-radius: 1.25rem !important;
    }

    body.shrink-fit-active #stage1-panel h2,
    body.shrink-fit-active #stage1-panel p {
      margin-bottom: 0.2rem !important;
    }

    body.shrink-fit-active #chain-pieces-bank {
      display: grid !important;
      grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
      gap: 0.35rem !important;
    }

    body.shrink-fit-active #chain-pieces-bank .draggable-item {
      padding: 0.35rem !important;
      border-radius: 0.75rem !important;
    }

    body.shrink-fit-active #chain-pieces-bank .draggable-item p {
      display: none !important;
    }

    body.shrink-fit-active #stage2-panel {
      padding: 0.4rem 0.6rem !important;
      border-radius: 1.25rem !important;
      gap: 0.3rem !important;
    }

    body.shrink-fit-active #scenario-card {
      padding: 0.35rem 0.5rem !important;
      border-radius: 0.75rem !important;
      margin-bottom: 0 !important;
    }

    body.shrink-fit-active #scenario-card h3 {
      font-size: 0.75rem !important;
      margin-bottom: 0 !important;
      line-height: 1.2 !important;
    }

    body.shrink-fit-active #precautions-grid {
      display: grid !important;
      grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
      gap: 0.3rem !important;
      max-height: 17vh !important;
      overflow-y: auto !important;
    }

    body.shrink-fit-active #precautions-grid .draggable-item {
      padding: 0.25rem 0.35rem !important;
      border-radius: 0.6rem !important;
    }

    body.shrink-fit-active #stage1-complete-box {
      padding: 0.6rem !important;
      margin-bottom: 0.3rem !important;
      border-radius: 1rem !important;
    }

    body.shrink-fit-active #stage1-complete-box button {
      padding: 0.5rem 1.25rem !important;
      font-size: 0.85rem !important;
    }

    /* Helper visibility class */
    .shrink-fit-only {
      display: none !important;
    }
    body.shrink-fit-active .shrink-fit-only {
      display: flex !important;
    }
  </style>
</head>
<body id="body-root" class="bg-[#e5ebf1] text-slate-800 min-h-screen antialiased select-none font-sans overflow-x-hidden">

  <!-- FLOATING TOUCH/MOUSE DRAG GHOST -->
  <div id="drag-ghost" class="bg-white text-slate-900 border-2 border-cyan-500 rounded-2xl p-3 shadow-2xl flex items-center gap-3">
    <span id="ghost-icon" class="text-2xl">🧩</span>
    <div>
      <div id="ghost-name" class="text-xs font-bold leading-tight">Piece</div>
      <div id="ghost-desc" class="text-[10px] text-slate-500">Drop into target circle</div>
    </div>
  </div>

  <!-- 🚨 BIG ALARM BANNER (ON WRONG ANSWER - GROUP CORRECTION PROMPT) 🚨 -->
  <div id="big-alarm-banner" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 max-w-xl w-[92%] bg-red-600 text-white rounded-3xl p-4 sm:p-5 shadow-2xl border-4 border-white transition-all transform -translate-y-24 opacity-0 pointer-events-none duration-300">
    <div class="flex items-start gap-3.5">
      <span class="text-3xl sm:text-4xl animate-bounce">🚨</span>
      <div class="flex-1">
        <div class="flex items-center justify-between">
          <span class="text-sm sm:text-base font-black uppercase tracking-wider text-yellow-300">
            BIG ALARM: INCORRECT ATTEMPT!
          </span>
          <button onclick="hideBigAlarm()" class="text-white/80 hover:text-white font-bold text-sm px-2">✕</button>
        </div>
        <p class="text-xs sm:text-sm text-white font-bold mt-1">
          Transmission chain remains active! That precaution does not break this specific link.
        </p>
        <div class="mt-2 p-2 rounded-xl bg-red-700/80 border border-red-400 text-[11px] sm:text-xs text-yellow-100 font-semibold flex items-center gap-1.5">
          <span>💡</span>
          <span><strong>Group Discussion:</strong> No worries! Discuss together as a team: Where does this transmission actually occur? Choose again together!</span>
        </div>
      </div>
    </div>
  </div>

  <!-- SOUND FX ENGINE (Web Audio API Synthesizer - 100% Offline & Reliable) -->
  <script>
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.enabled = true;
        this.volume = 0.85;
      }
      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }
      toggle(enable) {
        this.enabled = enable !== undefined ? enable : !this.enabled;
        return this.enabled;
      }

      // 🚨 BIG LOUD ALARM (Hospital Emergency Klaxon Siren)
      playBigAlarm() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;

        [0, 0.22, 0.44].forEach((offset, idx) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sawtooth';
          
          const freq = idx % 2 === 0 ? 820 : 560;
          osc.frequency.setValueAtTime(freq, now + offset);
          osc.frequency.exponentialRampToValueAtTime(freq * 0.75, now + offset + 0.18);

          const filter = this.ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(800, now + offset);
          filter.Q.setValueAtTime(3, now + offset);

          gain.gain.setValueAtTime(0.85 * this.volume, now + offset);
          gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.2);

          osc.connect(filter);
          filter.connect(gain);
          gain.connect(this.ctx.destination);

          osc.start(now + offset);
          osc.stop(now + offset + 0.21);
        });
      }

      // 👁️ EYE & SOUND ENFORCEMENT (Positive Triumphant Harmonic Chime)
      playEyeEnforcement() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        
        const freqs = [523.25, 659.25, 783.99, 1046.50, 1318.51];
        freqs.forEach((f, i) => {
          const t = now + i * 0.055;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(f, t);
          gain.gain.setValueAtTime(0.4 * this.volume, t);
          gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.45);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(t);
          osc.stop(t + 0.46);
        });
      }

      playSuccess() {
        this.playEyeEnforcement();
      }

      // Glass Shatter & Metal Snap
      playGlassBreak() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        
        const osc = this.ctx.createOscillator();
        const oscGain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(340, now);
        osc.frequency.exponentialRampToValueAtTime(45, now + 0.08);
        oscGain.gain.setValueAtTime(0.75 * this.volume, now);
        oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
        osc.connect(oscGain);
        oscGain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.1);

        const bufferSize = this.ctx.sampleRate * 0.45;
        const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = Math.random() * 2 - 1;
        }
        const whiteNoise = this.ctx.createBufferSource();
        whiteNoise.buffer = noiseBuffer;

        const filter = this.ctx.createBiquadFilter();
        filter.type = 'highpass';
        filter.frequency.setValueAtTime(1800, now);
        filter.frequency.exponentialRampToValueAtTime(7500, now + 0.35);

        const noiseGain = this.ctx.createGain();
        noiseGain.gain.setValueAtTime(0.9 * this.volume, now + 0.01);
        noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.42);

        whiteNoise.connect(filter);
        filter.connect(noiseGain);
        noiseGain.connect(this.ctx.destination);
        whiteNoise.start(now + 0.01);
        whiteNoise.stop(now + 0.45);

        [3400, 4850, 6200, 7850].forEach((freq, idx) => {
          const delay = now + 0.02 + idx * 0.035;
          const pingOsc = this.ctx.createOscillator();
          const pingGain = this.ctx.createGain();
          pingOsc.type = 'sine';
          pingOsc.frequency.setValueAtTime(freq, delay);
          pingGain.gain.setValueAtTime(0.35 * this.volume, delay);
          pingGain.gain.exponentialRampToValueAtTime(0.0001, delay + 0.28);
          pingOsc.connect(pingGain);
          pingGain.connect(this.ctx.destination);
          pingOsc.start(delay);
          pingOsc.stop(delay + 0.3);
        });
      }

      playLock() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, now);
        osc.frequency.exponentialRampToValueAtTime(880, now + 0.12);
        gain.gain.setValueAtTime(0.38 * this.volume, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.22);
      }

      playTick() {
        if (!this.enabled) return;
        this.init();
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(950, now);
        gain.gain.setValueAtTime(0.18 * this.volume, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.05);
      }

      playVictory() {
        if (!this.enabled) return;
        this.init();
        const chords = [
          { f: [523.25, 659.25, 783.99], t: 0.0, d: 0.2 },
          { f: [587.33, 739.99, 880.00], t: 0.2, d: 0.2 },
          { f: [659.25, 830.61, 987.77], t: 0.4, d: 0.25 },
          { f: [783.99, 987.77, 1174.66, 1567.98], t: 0.65, d: 0.75 }
        ];
        chords.forEach(c => {
          c.f.forEach(freq => {
            const now = this.ctx.currentTime + c.t;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(0.28 * this.volume, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + c.d);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + c.d + 0.05);
          });
        });
      }
    }

    const sound = new SoundEngine();
  </script>

  <!-- DRAWER BACKDROP (FOR LEFT MENU IN SHRINK-FIT MODE) -->
  <div id="drawer-backdrop" onclick="toggleLeftDrawer()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-80 hidden transition-opacity"></div>

  <!-- APP CONTAINER -->
  <div id="app" class="max-w-[1440px] mx-auto p-3 sm:p-5 flex flex-col gap-4 min-h-screen">
    
    <!-- 🌟 ATTRACTIVE HEADER: BIG STANDALONE LOGO ON LEFT + ATTACHED PILL BADGE + PUZZLE NAME & TIMER 🌟 -->
    <header id="main-header" class="bg-[#021329] text-white border-2 border-cyan-500/50 rounded-3xl p-5 sm:p-7 shadow-xl relative overflow-hidden transition-all duration-300">
      
      <div id="main-header-row" class="relative z-10 flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
        
        <!-- 🔍 LEFT SIDE: STANDALONE BIGGER LOGO (CLEAR & EASY TO READ) 🔍 -->
        <div id="header-logo-card" class="flex-shrink-0 bg-white p-3 sm:p-4 rounded-3xl shadow-2xl border-4 border-cyan-400 flex flex-col items-center justify-center max-w-[280px] w-full sm:w-auto">
          <img id="header-logo-img" src="ipc-logo.jpg" 
               alt="Infection Prevention & Control Training Center Logo" 
               class="w-48 h-48 sm:w-56 sm:h-56 md:w-64 md:h-64 object-contain rounded-2xl"
               style="image-rendering: -webkit-optimize-contrast;"
               onerror="this.src='template.jpg'" />
          <div id="header-logo-details" class="mt-2 text-center">
            <span class="block text-xs sm:text-sm font-black text-slate-900 tracking-tight leading-none uppercase">
              Infection Prevention & Control
            </span>
            <span class="block text-[11px] sm:text-xs font-black text-cyan-800 tracking-wider uppercase mt-0.5">
              Training Center
            </span>
            <span class="block text-[10px] sm:text-[11px] font-bold text-slate-600 mt-1">
              Hammam Jubran Rjoup /MSN, CPIC
            </span>
          </div>
        </div>

        <!-- RIGHT / MAIN: ATTACHED PILL BADGE + PUZZLE NAME + TIMER DIRECTLY UNDER TITLE -->
        <div id="header-main-col" class="flex-1 flex flex-col justify-center text-center lg:text-left w-full">
          
          <!-- 🏷️ EXACT ATTACHED PILL BADGE: [ HOSPITAL IPC TRAINING ] (CLICK OPENS SHRINK-TO-FIT PUZZLE) 🏷️ -->
          <div id="header-badge-pill" onclick="selectPuzzleWithFitMode()" title="Click to view puzzle in full shrink-to-fit screen" class="mb-2 flex justify-center lg:justify-start cursor-pointer group">
            <div class="inline-flex items-center gap-2 px-5 py-1.5 rounded-full bg-[#03152c] text-cyan-300 border-2 border-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.45)] group-hover:scale-105 transition-transform">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              <span class="text-xs sm:text-sm font-black uppercase tracking-wider">HOSPITAL IPC TRAINING</span>
            </div>
          </div>

          <!-- Main Title: IPC CHAIN BREAKER with Glowing Neon Shield (CLICK OPENS SHRINK-TO-FIT PUZZLE) -->
          <div id="header-title-box" onclick="selectPuzzleWithFitMode()" title="Click to view puzzle in full shrink-to-fit screen" class="flex items-center justify-center lg:justify-start gap-3 sm:gap-4 flex-wrap sm:flex-nowrap cursor-pointer group">
            <!-- Custom Glowing Neon Shield with Broken Chain SVG (matching header-banner.jpg) -->
            <svg class="main-title-svg w-12 h-12 sm:w-16 sm:h-16 md:w-20 md:h-20 flex-shrink-0 drop-shadow-[0_0_16px_rgba(6,182,212,0.85)] group-hover:scale-105 transition-transform" viewBox="0 0 100 110" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M50 8 L88 24 C88 68 50 98 50 98 C50 98 12 68 12 24 Z" stroke="#00e5ff" stroke-width="5" fill="#031e3b" stroke-linejoin="round" />
              <!-- Broken Chain Links in Center -->
              <rect x="20" y="48" width="22" height="12" rx="6" transform="rotate(-30 20 48)" stroke="#ffffff" stroke-width="5" fill="none" />
              <rect x="54" y="38" width="22" height="12" rx="6" transform="rotate(-30 54 38)" stroke="#ffffff" stroke-width="5" fill="none" />
              <!-- Shatter Sparks -->
              <path d="M48 30 L50 22" stroke="#00e5ff" stroke-width="3" stroke-linecap="round" />
              <path d="M42 34 L36 28" stroke="#00e5ff" stroke-width="3" stroke-linecap="round" />
              <path d="M54 62 L58 70" stroke="#00e5ff" stroke-width="3" stroke-linecap="round" />
              <path d="M46 64 L42 72" stroke="#00e5ff" stroke-width="3" stroke-linecap="round" />
            </svg>
            <div class="text-center lg:text-left">
              <h1 class="main-title-text text-2xl sm:text-3xl md:text-5xl font-black tracking-tight text-white leading-none group-hover:text-cyan-300 transition-colors">
                IPC CHAIN BREAKER
              </h1>
              <p id="header-subtitle" class="text-xs sm:text-sm md:text-base text-slate-200 font-medium mt-1.5 leading-snug max-w-2xl">
                10-Minute Team Infection Prevention & Control Simulation for Doctors & Nurses
              </p>
            </div>
          </div>

          <!-- ⏱️ TIMER DIRECTLY UNDER PUZZLE NAME (WITH ALL CONTROL BUTTONS) ⏱️ -->
          <div id="header-controls-row" class="mt-4 flex items-center justify-center lg:justify-start gap-2.5 sm:gap-3 flex-wrap">
            
            <!-- Simulation Timer Box -->
            <div id="timer-box" class="bg-[#03152c] border-2 border-cyan-400/80 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-2xl flex items-center gap-2.5 sm:gap-3 shadow-lg shadow-cyan-500/20">
              <span class="text-xl sm:text-2xl">⏱️</span>
              <div class="flex flex-col text-left">
                <span class="text-[8px] sm:text-[9px] uppercase tracking-wider text-cyan-300 font-black">Simulation Timer</span>
                <span id="timer-display" class="font-mono text-xl sm:text-3xl font-black text-cyan-300 leading-none">10:00</span>
              </div>
              <div class="flex items-center gap-1.5 ml-1 sm:ml-2 border-l border-cyan-500/40 pl-2 sm:pl-3">
                <button id="btn-timer-toggle" onclick="toggleTimer()" class="px-2.5 sm:px-3.5 py-1 sm:py-1.5 text-xs font-black rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white transition active:scale-95 shadow flex items-center gap-1">
                  ▶ Start
                </button>
                <button onclick="resetTimer()" class="px-2 sm:px-2.5 py-1 sm:py-1.5 text-xs font-bold rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition active:scale-95">
                  ↺ Reset
                </button>
              </div>
            </div>

            <!-- Active Group Turn Pill (Visible in Shrink-Fit Mode) -->
            <div id="header-turn-pill" class="shrink-fit-only px-3 py-1.5 rounded-xl bg-[#03152c] border-2 border-cyan-400/80 text-xs font-bold text-white items-center gap-2 shadow">
              <span>👥</span>
              <span id="header-turn-name" class="font-extrabold text-cyan-200">Group 1</span>
              <span id="header-turn-score" class="font-mono font-black text-white">0 pts</span>
              <button onclick="moveToNextGroup()" title="Rotate turn to next group" class="px-2 py-0.5 rounded-lg bg-cyan-700 hover:bg-cyan-600 text-[10px] text-white font-black shadow">
                ⏭️ Next
              </button>
            </div>

            <!-- ⚙️ SPECIAL SCREEN FOR PROJECT MANAGEMENT BUTTON -->
            <button onclick="openModal('pm-modal')" class="px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-2xl bg-gradient-to-r from-cyan-600 to-teal-600 hover:from-cyan-500 hover:to-teal-500 border border-cyan-300 text-white text-xs sm:text-sm font-black flex items-center gap-1.5 sm:gap-2 transition active:scale-95 shadow-xl shadow-cyan-600/25">
              <span>⚙️</span>
              <span class="hidden md:inline">Project Management</span>
              <span class="md:hidden">PM</span>
            </button>

            <!-- QUICK TRAINER ACTIONS (MATCHING USER SCREENSHOT media_1794328841128_db9016ad.png) -->
            <div class="flex items-center gap-1.5 sm:gap-2">
              <button onclick="toggleSound()" id="hdr-sound-btn" title="Toggle Sound FX" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#03152c] border-2 border-slate-700 hover:border-cyan-400 text-cyan-300 flex items-center justify-center text-base sm:text-lg transition active:scale-95 shadow">
                🔊
              </button>
              <button onclick="sound.playGlassBreak(); triggerShake(); showToast('💥 Test Shatter FX Triggered!', 'Glass crack, noise burst, metal snap, and screen shake active.', 'emerald');" class="px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-full bg-[#03152c] border-2 border-amber-500/70 hover:border-amber-400 text-amber-300 text-xs font-extrabold flex items-center gap-1.5 transition active:scale-95 shadow">
                <span class="text-pink-400">💥</span>
                <span class="hidden xl:inline">Test Shatter FX</span>
              </button>
              <button onclick="openModal('debrief-modal')" class="px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-full bg-[#1e1b4b] border-2 border-indigo-400/70 hover:border-indigo-300 text-indigo-200 text-xs font-extrabold flex items-center gap-1.5 transition active:scale-95 shadow">
                <span>📋</span>
                <span class="hidden xl:inline">Trainer Key</span>
              </button>
              <button id="btn-toggle-fit" onclick="toggleShrinkFitMode()" title="Toggle Shrink to Fit Full Page without scrolling" class="px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-cyan-900/90 border-2 border-cyan-400 hover:bg-cyan-800 text-cyan-200 text-xs font-black flex items-center gap-1.5 transition active:scale-95 shadow">
                <span>📐</span>
                <span class="hidden sm:inline">Fit Screen</span>
              </button>
              <button onclick="toggleLeftDrawer()" title="Open Left Training Menu" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#03152c] border-2 border-cyan-500/60 hover:border-cyan-300 text-cyan-300 flex items-center justify-center text-sm transition active:scale-95 shadow">
                🧭
              </button>
              <button onclick="toggleFullScreen()" title="Full Screen Presentation" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-cyan-500/40 text-slate-200 flex items-center justify-center text-base transition active:scale-95 shadow">
                ⛶
              </button>
            </div>

          </div>

          <!-- Gradient Accent Divider Line -->
          <div id="header-divider" class="w-full max-w-lg h-[2px] bg-gradient-to-r from-cyan-400 via-teal-300 to-transparent my-2.5"></div>

          <!-- Developer Attribution -->
          <div id="header-attribution" class="flex items-center justify-center lg:justify-start gap-1.5 text-xs sm:text-sm font-semibold text-cyan-200">
            <span class="text-slate-300">Developed by</span>
            <span class="font-extrabold text-white underline decoration-cyan-400 decoration-2 underline-offset-4">
              Hammam Jubran Rjoup /MSN, CPIC
            </span>
          </div>

        </div>

      </div>
    </header>

    <!-- 👥 SQUADS / GROUP TURNS BAR (NO DEFAULT NAMES, NO SCROLLBAR, EASY NEXT TURN & ARCHIVE) 👥 -->
    <div id="squads-bar" class="bg-white border border-slate-300 rounded-2xl p-3 sm:p-4 shadow-sm flex flex-col md:flex-row items-center justify-between gap-3">
      
      <!-- Group Tabs Container (Wrapped, responsive, no ugly grey scrollbar) -->
      <div class="flex items-center gap-2 flex-wrap w-full md:w-auto" id="team-tabs">
        <!-- Dynamically populated: Group 1, Group 2, etc. -->
      </div>

      <!-- Group Navigation & Archive Actions -->
      <div class="flex items-center gap-2 w-full md:w-auto justify-end flex-wrap">
        
        <!-- ⏭️ MOVE TO OTHER GROUP / ROTATE TURN -->
        <button onclick="moveToNextGroup()" title="Rotate turn to the next puzzle group" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-cyan-700 to-teal-700 hover:from-cyan-600 hover:to-teal-600 text-white text-xs font-black flex items-center gap-1.5 transition active:scale-95 shadow">
          <span>⏭️</span>
          <span>Next Group Turn</span>
        </button>

        <button onclick="addTeamPrompt()" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-300 text-xs font-bold text-slate-700 flex items-center gap-1 transition">
          + Add Group
        </button>
        <button onclick="editCurrentTeamName()" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-300 text-xs font-bold text-slate-700 flex items-center gap-1 transition">
          ✏️ Rename
        </button>

        <!-- 📁 ARCHIVE SESSION BUTTON -->
        <button onclick="archiveCurrentSession()" title="Save current round into historical archive" class="px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-300 text-amber-900 text-xs font-bold flex items-center gap-1 transition">
          <span>📁</span>
          <span>Save in Archive</span>
        </button>

        <button onclick="openModal('archive-modal')" title="View past archived sessions" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-300 text-xs font-bold text-slate-700 flex items-center gap-1 transition">
          <span>📂</span>
          <span>View Archive</span>
        </button>

        <!-- Active Score Badge -->
        <div class="bg-slate-50 px-3.5 py-1.5 rounded-xl border border-cyan-500/40 flex items-center gap-2 shadow-inner">
          <span class="text-xs uppercase font-extrabold text-cyan-700">Turn Score:</span>
          <span id="current-score" class="text-xl font-black text-slate-900">0</span>
          <span class="text-xs text-slate-500 font-semibold">pts</span>
        </div>

      </div>
    </div>

    <!-- 🧭 TOP MOBILE TAB NAVIGATION (VISIBLE ON SMALL/MEDIUM SCREENS) 🧭 -->
    <div class="flex lg:hidden items-center gap-2 p-1.5 rounded-2xl bg-white border border-slate-300 w-full shadow-sm">
      <button onclick="selectPuzzleWithFitMode()" id="mobile-tab-puzzle" 
              class="flex-1 py-2 px-3 rounded-xl text-xs font-black transition flex items-center justify-center gap-1.5 bg-cyan-700 text-white shadow">
        <span>1️⃣</span> <span>Chain & Break Puzzle</span>
      </button>
      <button onclick="switchMainView('icebreaker')" id="mobile-tab-icebreaker" 
              class="flex-1 py-2 px-3 rounded-xl text-xs font-black transition flex items-center justify-center gap-1.5 bg-slate-100 text-slate-700 hover:bg-slate-200">
        <span>2️⃣</span> <span>🧊 Ice Breaker</span>
      </button>
    </div>

    <!-- 🧭 MAIN TWO-COLUMN WORKSPACE: LEFT MENU (SIDEBAR) + ACTIVE MODULE VIEW 🧭 -->
    <div class="flex flex-col lg:flex-row gap-5 items-start w-full">
      
      <!-- 📌 LEFT NAVIGATION MENU 📌 -->
      <aside id="left-nav-menu" class="w-full lg:w-72 xl:w-80 flex-shrink-0 flex flex-col gap-4 select-none">
        
        <!-- Module Navigation Box -->
        <div class="bg-[#021329] border-2 border-cyan-500/60 rounded-3xl p-4 sm:p-5 text-white shadow-xl">
          
          <div class="flex items-center justify-between pb-3 border-b border-cyan-500/30 mb-3.5">
            <div class="flex items-center gap-2">
              <span class="text-xl">🧭</span>
              <span class="text-xs font-black uppercase tracking-wider text-cyan-300">Training Menu</span>
            </div>
            <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-[#03203f] text-cyan-200 border border-cyan-400/40">
              2 Modules
            </span>
          </div>

          <!-- The 2 User-Requested Navigation Items -->
          <div class="flex flex-col gap-2.5">
            
            <!-- 1- Chain of Infection, Break the Chain Puzzle -->
            <button id="menu-btn-puzzle" onclick="selectPuzzleWithFitMode()" 
                    class="w-full text-left p-3.5 rounded-2xl border-2 transition-all duration-200 flex flex-col gap-1 shadow active:scale-98 bg-gradient-to-r from-cyan-950 via-[#032347] to-cyan-900 border-cyan-400 text-white shadow-cyan-500/30 ring-2 ring-cyan-400/30">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 font-black text-xs sm:text-sm text-cyan-300">
                  <span class="text-sm">1️⃣</span>
                  <span>Chain of Infection & Break Chain</span>
                </div>
                <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
              </div>
              <p class="text-[10px] text-slate-300 font-medium leading-tight pl-6">
                Stage 1: Assemble Chain • Stage 2: Break Links with Precautions
              </p>
              <div class="flex items-center gap-1.5 pl-6 mt-1">
                <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-cyan-400/20 text-cyan-200 border border-cyan-400/40">
                  Core Simulation
                </span>
                <span id="menu-puzzle-status" class="text-[9px] font-bold text-amber-300">Stage 1 Active</span>
              </div>
            </button>

            <!-- 2- Ice Breaker -->
            <button id="menu-btn-icebreaker" onclick="switchMainView('icebreaker')" 
                    class="w-full text-left p-3.5 rounded-2xl border-2 transition-all duration-200 flex flex-col gap-1 shadow active:scale-98 bg-slate-900/80 hover:bg-[#03203f] border-slate-700 hover:border-teal-400 text-slate-300 hover:text-white">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 font-black text-xs sm:text-sm text-white">
                  <span class="text-sm">2️⃣</span>
                  <span>Ice Breaker</span>
                </div>
                <span class="text-sm">🧊</span>
              </div>
              <p class="text-[10px] text-slate-400 font-medium leading-tight pl-6">
                Clinical Dilemmas & Myth Busters warm-up for Doctors & Nurses
              </p>
              <div class="flex items-center gap-1.5 pl-6 mt-1">
                <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-teal-500/20 text-teal-300 border border-teal-500/40">
                  Team Warm-Up
                </span>
                <span class="text-[9px] font-bold text-slate-400">8 Dilemmas</span>
              </div>
            </button>

          </div>

          <!-- Trainer Quick Tools Section in Menu -->
          <div class="mt-4 pt-3.5 border-t border-cyan-500/30 flex flex-col gap-1.5">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 mb-1">
              Trainer Short-Cuts
            </span>
            <button onclick="openModal('pm-modal')" class="w-full text-left px-3 py-2 rounded-xl bg-slate-900/70 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-bold flex items-center gap-2 border border-slate-700/60 transition">
              <span>⚙️</span> <span>Project Management</span>
            </button>
            <button onclick="openModal('debrief-modal')" class="w-full text-left px-3 py-2 rounded-xl bg-slate-900/70 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-bold flex items-center gap-2 border border-slate-700/60 transition">
              <span>📋</span> <span>Trainer Key & Debrief</span>
            </button>
            <button onclick="openModal('archive-modal')" class="w-full text-left px-3 py-2 rounded-xl bg-slate-900/70 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-bold flex items-center gap-2 border border-slate-700/60 transition">
              <span>📁</span> <span>Session Archive</span>
            </button>
          </div>

        </div>

        <!-- Active Squad Status Card in Left Menu -->
        <div class="bg-white border border-slate-300 rounded-3xl p-4 shadow-sm text-slate-800">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-wider">Active Group Turn</span>
            <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-800" id="left-menu-turn-badge">Turn Active</span>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm font-black text-slate-900" id="left-menu-team-name">Group 1</div>
              <div class="text-[10px] text-slate-500 font-medium">Ready to discuss & score</div>
            </div>
            <div class="text-right">
              <div class="text-2xl font-black text-cyan-800" id="left-menu-team-score">0</div>
              <div class="text-[9px] text-slate-400 uppercase font-black">Score</div>
            </div>
          </div>
          <button onclick="moveToNextGroup()" class="w-full mt-3 py-2 rounded-xl bg-gradient-to-r from-cyan-700 to-teal-700 hover:from-cyan-600 hover:to-teal-600 text-white text-xs font-black flex items-center justify-center gap-1.5 shadow transition active:scale-95">
            <span>⏭️</span> <span>Next Group Turn</span>
          </button>
        </div>

      </aside>

      <!-- 🖥️ MAIN CONTENT AREA (MODULE VIEWS) 🖥️ -->
      <main class="flex-1 min-w-0 w-full flex flex-col gap-5">
        
        <!-- ======================================================== -->
        <!-- 🧩 MODULE VIEW 1: CHAIN OF INFECTION & BREAK PUZZLE 🧩 -->
        <!-- ======================================================== -->
        <div id="view-puzzle" class="flex flex-col gap-5 items-center w-full">
          
          <!-- CENTER: VISUAL 16:9 BOARD CONTAINER (ALIGNED WITH TEMPLATE.JPG) -->
          <div id="board-card" class="w-full bg-white border border-slate-300 rounded-3xl p-3 sm:p-5 shadow-md flex flex-col items-center relative overflow-hidden transition-all duration-300">
            
            <!-- Stage Status Banner -->
            <div id="board-card-header" class="w-full flex items-center justify-between mb-3 pb-2.5 border-b border-slate-200 flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span id="stage-badge" class="px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-cyan-100 text-cyan-800 border border-cyan-300 shadow-sm">
                  STAGE 1: ASSEMBLE CHAIN
                </span>
                <span id="stage-desc" class="text-xs text-slate-600 font-semibold">
                  Drag or tap labels from below into the 6 empty circular positions in clockwise order.
                </span>
              </div>
              
              <div class="flex items-center gap-3">
                <button id="btn-bg-toggle" onclick="toggleBoardBackground()" class="text-xs text-cyan-700 hover:underline font-bold flex items-center gap-1">
                  🖼️ <span id="bg-mode-label">Template View</span>
                </button>
                <button onclick="autoSolveStage1()" class="text-xs text-slate-400 hover:text-cyan-600 underline font-medium">
                  (Auto-Fill)
                </button>
              </div>
            </div>

            <!-- 16:9 BOARD CANVAS (Matches template.jpg 1024x576 exactly) -->
            <div id="board-aspect-box" class="w-full max-w-[900px] aspect-[1024/576] relative rounded-2xl overflow-hidden border-2 border-slate-300 shadow-sm bg-slate-50 flex items-center justify-center select-none">
              
              <!-- Background 1: template.jpg Graphic Template -->
              <img id="template-bg-img" 
                   src="template.jpg" 
                   alt="Chain of Infection Template" 
                   class="absolute inset-0 w-full h-full object-contain pointer-events-none transition-opacity duration-300"
                   onerror="handleImageFallback(this)" />

              <!-- Background 2: Dynamic High-Tech SVG Fallback -->
              <svg id="svg-board-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-0 transition-opacity duration-300" viewBox="0 0 1024 576">
                <defs>
                  <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#f0f9ff" />
                    <stop offset="50%" stop-color="#e0f2fe" />
                    <stop offset="100%" stop-color="#bae6fd" />
                  </linearGradient>
                  <marker id="arrowTeal" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 1 L 9 5 L 0 9 z" fill="#0284c7" />
                  </marker>
                </defs>
                <rect width="1024" height="576" fill="url(#bgGrad)" />
                <circle cx="512" cy="331" r="185" fill="none" stroke="#38bdf8" stroke-width="4" stroke-dasharray="10 8" opacity="0.6" />
                <path d="M 590 190 A 185 185 0 0 1 665 240" fill="none" stroke="#0284c7" stroke-width="5" marker-end="url(#arrowTeal)" />
                <path d="M 720 325 A 185 185 0 0 1 700 375" fill="none" stroke="#0284c7" stroke-width="5" marker-end="url(#arrowTeal)" />
                <path d="M 645 460 A 185 185 0 0 1 585 490" fill="none" stroke="#0284c7" stroke-width="5" marker-end="url(#arrowTeal)" />
                <path d="M 435 490 A 185 185 0 0 1 375 460" fill="none" stroke="#0284c7" stroke-width="5" marker-end="url(#arrowTeal)" />
                <path d="M 300 375 A 185 185 0 0 1 300 305" fill="none" stroke="#0284c7" stroke-width="5" marker-end="url(#arrowTeal)" />
                <path d="M 360 215 A 185 185 0 0 1 435 185" fill="none" stroke="#0284c7" stroke-width="5" marker-end="url(#arrowTeal)" />
                <text x="512" y="55" font-family="sans-serif" font-weight="900" font-size="24" fill="#032b5f" text-anchor="middle">CHAIN OF INFECTION — BREAK THE CHAIN</text>
                <text x="512" y="80" font-family="sans-serif" font-weight="600" font-size="14" fill="#0284c7" text-anchor="middle">Drag each label to the correct empty position</text>
              </svg>

              <!-- CENTER SHIELD & STAGE 2 BREAK ZONE (Center 50%, 59.9%) -->
              <div id="center-shield" 
                   onclick="handleCenterZoneClick()"
                   class="circle-slot !w-[22%] !aspect-square !top-[59.9%] !left-[49.8%] bg-white/95 border-2 border-cyan-500 shadow-xl backdrop-blur-sm z-30 flex flex-col items-center justify-center text-center p-1.5 transition-all duration-300">
                <div id="center-icon" class="text-2xl sm:text-3xl mb-0.5 transform transition-transform duration-300">
                  🔗💥
                </div>
                <span class="text-[9px] sm:text-[10px] font-black tracking-wider text-cyan-900 uppercase">STANDARD</span>
                <span class="text-[8px] sm:text-[9px] font-bold text-slate-700 uppercase tracking-widest leading-none">PRECAUTIONS</span>
                <div id="chain-status-text" class="mt-1 text-[8px] sm:text-[9px] text-amber-800 font-bold px-2 py-0.5 rounded-full bg-amber-100 leading-tight">
                  6 Links Active
                </div>
              </div>

              <!-- THE 6 CIRCULAR DROP SLOTS WITH EXPANDED MAGNETIC SNAP ZONES -->
              
              <!-- Node 0: TOP (Position 1: Agent) Center: (49.8%, 28.8%) -->
              <div id="node-0" data-slot="0" 
                   class="circle-slot !top-[28.8%] !left-[49.8%] border-2 border-dashed border-cyan-700 bg-white/85 shadow-md">
                <span class="text-[10px] sm:text-xs font-black text-cyan-900 leading-tight">Position 1</span>
                <span class="slot-placeholder text-[8px] sm:text-[10px] text-slate-500 font-semibold">Drop Agent</span>
              </div>

              <!-- Node 1: TOP-RIGHT (Position 2: Reservoir) Center: (70.2%, 39.9%) -->
              <div id="node-1" data-slot="1" 
                   class="circle-slot !top-[39.9%] !left-[70.2%] border-2 border-dashed border-cyan-700 bg-white/85 shadow-md">
                <span class="text-[10px] sm:text-xs font-black text-cyan-900 leading-tight">Position 2</span>
                <span class="slot-placeholder text-[8px] sm:text-[10px] text-slate-500 font-semibold">Drop Reservoir</span>
              </div>

              <!-- Node 2: BOTTOM-RIGHT (Position 3: Portal of Exit) Center: (70.3%, 71.9%) -->
              <div id="node-2" data-slot="2" 
                   class="circle-slot !top-[71.9%] !left-[70.3%] border-2 border-dashed border-cyan-700 bg-white/85 shadow-md">
                <span class="text-[10px] sm:text-xs font-black text-cyan-900 leading-tight">Position 3</span>
                <span class="slot-placeholder text-[8px] sm:text-[10px] text-slate-500 font-semibold">Drop Exit</span>
              </div>

              <!-- Node 3: BOTTOM (Position 4: Mode of Transport) Center: (49.8%, 86.3%) -->
              <div id="node-3" data-slot="3" 
                   class="circle-slot !top-[86.3%] !left-[49.8%] border-2 border-dashed border-cyan-700 bg-white/85 shadow-md">
                <span class="text-[10px] sm:text-xs font-black text-cyan-900 leading-tight">Position 4</span>
                <span class="slot-placeholder text-[8px] sm:text-[10px] text-slate-500 font-semibold">Drop Mode</span>
              </div>

              <!-- Node 4: BOTTOM-LEFT (Position 5: Portal of Entry) Center: (29.5%, 71.9%) -->
              <div id="node-4" data-slot="4" 
                   class="circle-slot !top-[71.9%] !left-[29.5%] border-2 border-dashed border-cyan-700 bg-white/85 shadow-md">
                <span class="text-[10px] sm:text-xs font-black text-cyan-900 leading-tight">Position 5</span>
                <span class="slot-placeholder text-[8px] sm:text-[10px] text-slate-500 font-semibold">Drop Entry</span>
              </div>

              <!-- Node 5: TOP-LEFT (Position 6: Susceptible Host) Center: (29.3%, 39.8%) -->
              <div id="node-5" data-slot="5" 
                   class="circle-slot !top-[39.8%] !left-[29.3%] border-2 border-dashed border-cyan-700 bg-white/85 shadow-md">
                <span class="text-[10px] sm:text-xs font-black text-cyan-900 leading-tight">Position 6</span>
                <span class="slot-placeholder text-[8px] sm:text-[10px] text-slate-500 font-semibold">Drop Host</span>
              </div>

            </div>

            <!-- 👁️ VISUAL & EYE ENFORCEMENT TOAST -->
            <div id="shatter-toast" class="w-full max-w-[900px] mt-3 p-3 rounded-2xl bg-slate-900 text-white text-center transition-all opacity-0 pointer-events-none transform translate-y-2 shadow-xl">
              <div class="flex items-center justify-center gap-2">
                <span id="toast-eye-icon" class="text-xl">👁️</span>
                <span id="toast-title" class="font-black text-xs sm:text-sm text-emerald-400 uppercase tracking-wide"></span>
              </div>
              <p id="toast-desc" class="text-xs text-slate-200 mt-0.5 leading-snug"></p>
            </div>

          </div>

          <!-- ⬇️ CHOICES PLACED DIRECTLY BELOW THE BOARD (SUPER EASY DRAG & DROP) ⬇️ -->
          <div id="puzzle-choices-container" class="w-full max-w-[900px]">
            
            <!-- 🎉 PROCEED TO STAGE 2 BUTTON (SHOWN ONLY WHEN STAGE 1 IS COMPLETED) 🎉 -->
            <div id="stage1-complete-box" class="hidden w-full p-5 rounded-3xl bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-700 text-white text-center shadow-xl mb-4 border-2 border-white">
              <div class="flex items-center justify-center gap-2 text-xl sm:text-2xl font-black mb-1">
                <span>🎉</span>
                <span>STAGE 1 COMPLETE: CHAIN OF INFECTION ASSEMBLED!</span>
                <span>🎉</span>
              </div>
              <p class="text-xs sm:text-sm text-emerald-100 font-medium max-w-xl mx-auto mb-4">
                All 6 links are correctly identified in order. Take a moment to review the transmission cycle with your group, then click below to enter Stage 2:
              </p>
              <button onclick="activateStage2()" class="px-8 py-3.5 rounded-2xl bg-white hover:bg-emerald-50 text-emerald-900 font-black text-sm sm:text-base shadow-2xl transition active:scale-95 flex items-center gap-3 mx-auto">
                <span class="text-xl">💥</span>
                <span>CLICK TO PROCEED TO STAGE 2: BREAK THE CHAIN!</span>
                <span class="text-xl">➡️</span>
              </button>
            </div>

            <!-- STAGE 1 CHOICES: THE 6 CHAIN OF INFECTION LABELS (BELOW THE BOARD) -->
            <div id="stage1-panel" class="bg-white border border-slate-300 rounded-3xl p-4 sm:p-5 shadow-md">
              <div class="flex items-center justify-between mb-2">
                <h2 class="text-sm sm:text-base font-black text-slate-900 flex items-center gap-2">
                  <span>🧩</span> Chain of Infection Labels (Drag Up to Target Circles or Tap to Place)
                </h2>
                <div class="flex items-center gap-2 flex-wrap">
                  <button type="button" onclick="shuffleAndRenderStage1(true)" title="Shuffle order of choices" class="px-2.5 py-1 rounded-lg bg-cyan-100 hover:bg-cyan-200 text-cyan-900 border border-cyan-300 text-xs font-black flex items-center gap-1 transition active:scale-95 shadow-sm">
                    <span>🔀</span> <span>Shuffle Choices</span>
                  </button>
                  <span class="text-[11px] font-bold text-cyan-800 bg-cyan-50 px-2.5 py-0.5 rounded-lg border border-cyan-200">
                    Magnetic Drag & Drop
                  </span>
                </div>
              </div>
              <p class="text-xs text-slate-500 mb-3 font-medium">
                Drag each label directly onto its matching circle above, or tap a label then tap a circle:
              </p>
              <div id="chain-pieces-bank" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                <!-- Dynamically populated pieces -->
              </div>
            </div>

            <!-- STAGE 2 CHOICES: 10 STANDARD PRECAUTIONS (ACTIVATES AFTER PROCEEDING) -->
            <div id="stage2-panel" class="hidden bg-white border border-slate-300 rounded-3xl p-4 sm:p-5 shadow-md flex-col gap-3.5">
              <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                <div>
                  <h2 class="text-sm sm:text-base font-black text-emerald-700 flex items-center gap-2">
                    <span>💥</span> STAGE 2: BREAK THE CHAIN!
                  </h2>
                  <p class="text-xs text-slate-500 font-medium">Deploy Standard Precautions against clinical transmissions!</p>
                </div>
                <span id="break-count" class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black border border-emerald-300">
                  0 / 10 Broken
                </span>
              </div>

              <!-- Active Scenario Card -->
              <div id="scenario-card" class="bg-gradient-to-br from-cyan-50 via-teal-50 to-emerald-50 border border-cyan-200 rounded-2xl p-4 shadow-sm">
                <div class="flex items-center justify-between mb-1.5 flex-wrap gap-1">
                  <span id="scenario-num" class="text-[11px] font-extrabold text-cyan-900 uppercase tracking-wider">Scenario 1 of 10</span>
                  <span id="scenario-target-badge" class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300">
                    Targeting Link
                  </span>
                </div>
                <h3 id="scenario-question" class="text-xs sm:text-sm font-bold text-slate-900 leading-snug mb-1.5"></h3>
                <p id="scenario-hint" class="text-[11px] text-slate-600 italic font-medium flex items-center gap-1"></p>
              </div>

              <!-- 10 Standard Precautions Weapons (Drag directly onto target link above!) -->
              <div>
                <div class="flex items-center justify-between mb-1.5 flex-wrap gap-2">
                  <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Select or Drag Precaution to Break the Target Link:</span>
                  <div class="flex items-center gap-2">
                    <button type="button" onclick="shuffleAndRenderStage2(true)" title="Shuffle order of precautions" class="px-2.5 py-0.5 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-emerald-900 border border-emerald-300 text-[10px] font-black flex items-center gap-1 transition active:scale-95 shadow-sm">
                      <span>🔀</span> <span>Shuffle Choices</span>
                    </button>
                    <span class="text-[10px] text-slate-500 font-semibold">10 WHO Core Elements</span>
                  </div>
                </div>
                <div id="precautions-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5 max-h-[340px] overflow-y-auto pr-1">
                  <!-- Dynamically populated 10 Standard Precautions -->
                </div>
              </div>
            </div>

          </div>

        </div>

        <!-- ======================================================== -->
        <!-- 🧊 MODULE VIEW 2: IPC TEAM ICE BREAKER 🧊                -->
        <!-- ======================================================== -->
        <div id="view-icebreaker" class="hidden flex flex-col gap-5 w-full">
          
          <!-- ICE BREAKER TOP BANNER -->
          <div class="bg-[#021329] text-white border-2 border-teal-500/50 rounded-3xl p-5 sm:p-6 shadow-xl relative overflow-hidden">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#03203f] text-teal-300 border border-teal-400 text-xs font-black uppercase tracking-wider mb-2">
                  <span>🧊</span>
                  <span>MODULE 2: CLINICAL WARM-UP ACTIVITY</span>
                </div>
                <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-white flex items-center gap-2">
                  <span>IPC Team Ice Breaker</span>
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-teal-500/20 text-teal-300 border border-teal-400/40">
                    Clinical Dilemmas & Myth Busters
                  </span>
                </h2>
                <p class="text-xs sm:text-sm text-slate-300 font-medium mt-1">
                  Engaging clinical debate challenge for doctors & nurses. Discuss as a group, select your answer, and bank +50 points!
                </p>
              </div>

              <!-- Quick Ice Breaker Score Pill & Return to Puzzle Button -->
              <div class="flex items-center gap-2.5 flex-wrap">
                <div class="bg-[#03152c] border border-teal-400/60 px-3.5 py-2 rounded-2xl flex items-center gap-2 shadow">
                  <span class="text-xl">🏆</span>
                  <div class="text-left">
                    <span class="text-[9px] uppercase tracking-wider text-teal-300 font-black block">Award Pts</span>
                    <span class="text-xs font-black text-white">+50 pts / Q</span>
                  </div>
                </div>
                <button onclick="switchMainView('puzzle')" class="px-4 py-2.5 rounded-2xl bg-cyan-700 hover:bg-cyan-600 text-white font-black text-xs transition active:scale-95 shadow flex items-center gap-1.5">
                  <span>🧩</span>
                  <span>Go to Main Puzzle</span>
                  <span>➡️</span>
                </button>
              </div>
            </div>
          </div>

          <!-- ACTIVE DILEMMA CARD -->
          <div class="bg-white border border-slate-300 rounded-3xl p-5 sm:p-7 shadow-md flex flex-col gap-5">
            
            <!-- Dilemma Header & Pagination Dots -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-200 flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <span id="ib-scenario-badge" class="px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-teal-100 text-teal-900 border border-teal-300">
                  DILEMMA 1 OF 8
                </span>
                <span id="ib-topic-tag" class="text-xs font-bold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-md border border-slate-300">
                  Hand Hygiene
                </span>
              </div>

              <!-- Pagination Indicators -->
              <div id="ib-dots-container" class="flex items-center gap-1.5">
                <!-- 8 dots generated by JS -->
              </div>
            </div>

            <!-- Vignette / Dilemma Text -->
            <div class="bg-gradient-to-br from-slate-50 to-teal-50/40 p-4 sm:p-5 rounded-2xl border border-slate-200">
              <div class="flex items-start gap-3.5">
                <span id="ib-icon" class="text-3xl sm:text-4xl p-2 rounded-2xl bg-white shadow-sm border border-slate-200 flex-shrink-0">🧼</span>
                <div class="flex-1">
                  <h3 id="ib-title" class="text-base sm:text-lg font-black text-slate-900"></h3>
                  <p id="ib-vignette" class="text-xs sm:text-sm text-slate-700 mt-1 leading-relaxed font-medium"></p>
                  <div class="mt-2.5 p-2.5 rounded-xl bg-amber-50 border border-amber-300 text-xs font-bold text-amber-900 flex items-center gap-2">
                    <span>❓</span>
                    <span id="ib-question"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Choices Buttons (Choice A vs Choice B) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="ib-choices-container">
              <!-- Generated via JS -->
            </div>

            <!-- Rationale & Debrief Reveal Box (Hidden until answered) -->
            <div id="ib-feedback-box" class="hidden p-4 sm:p-5 rounded-2xl border transition-all duration-300">
              <div class="flex items-center gap-2 mb-1.5">
                <span id="ib-feedback-icon" class="text-2xl">✅</span>
                <span id="ib-feedback-title" class="font-black text-sm uppercase tracking-wide"></span>
              </div>
              <p id="ib-feedback-rationale" class="text-xs sm:text-sm leading-relaxed"></p>
              
              <!-- Group Attribution Bar -->
              <div class="mt-4 pt-3 border-t border-slate-300/40 flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2 text-xs">
                  <span class="font-bold text-slate-700">Award +50 points to:</span>
                  <div id="ib-team-award-buttons" class="flex items-center gap-1.5">
                    <!-- Populated dynamically -->
                  </div>
                </div>
                <span id="ib-points-awarded-badge" class="text-xs font-bold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-md border border-emerald-300 hidden">
                  +50 Pts Awarded!
                </span>
              </div>
            </div>

            <!-- Controls Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-slate-200 flex-wrap gap-3">
              <div class="flex items-center gap-2">
                <button onclick="prevIceBreaker()" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition flex items-center gap-1">
                  <span>⬅️</span> <span>Previous</span>
                </button>
                <button onclick="nextIceBreaker()" class="px-4 py-2 rounded-xl bg-cyan-700 hover:bg-cyan-600 text-white font-bold text-xs transition flex items-center gap-1 shadow">
                  <span>Next Dilemma</span> <span>➡️</span>
                </button>
              </div>

              <!-- Proceed to Core Puzzle Button -->
              <button onclick="switchMainView('puzzle')" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-black text-xs sm:text-sm shadow-md flex items-center gap-2 transition active:scale-95">
                <span>🚀</span>
                <span>Ready for Main Puzzle: Chain of Infection & Break the Chain!</span>
                <span>➡️</span>
              </button>
            </div>

          </div>

        </div>

      </main>

    </div>

    <!-- FOOTER WITH ACCREDITATION & CONTROLS -->
    <footer class="mt-auto py-3 text-center text-xs text-slate-500 flex flex-wrap items-center justify-between border-t border-slate-300">
      <div class="flex items-center gap-2">
        <span>Standards: <strong>WHO Infection Prevention & Control</strong> & <strong>CDC Standard Precautions</strong></span>
      </div>
      <div class="flex items-center gap-3">
        <button onclick="openModal('pm-modal')" class="hover:text-cyan-700 underline font-semibold">Project Management & Controls</button>
        <span>•</span>
        <button onclick="openModal('debrief-modal')" class="hover:text-cyan-700 underline font-semibold">Trainer Facilitation Guide</button>
        <span>•</span>
        <button onclick="openModal('archive-modal')" class="hover:text-cyan-700 underline font-semibold">Session Archive</button>
        <span>•</span>
        <button onclick="resetCurrentGame()" class="hover:text-red-600 underline font-semibold">Reset Round</button>
      </div>
    </footer>

  </div>

  <!-- ⚙️ SPECIAL SCREEN FOR PROJECT MANAGEMENT ⚙️ -->
  <div id="pm-modal" class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-5 hidden">
    <div class="bg-white border border-slate-300 rounded-3xl max-w-4xl w-full p-5 sm:p-8 shadow-2xl relative max-h-[92vh] overflow-y-auto">
      
      <!-- PM Modal Header -->
      <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-5">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-600 to-teal-500 flex items-center justify-center text-2xl text-white shadow-lg shadow-cyan-500/20">
            ⚙️
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
              <span>Project Management Console</span>
              <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-800 border border-cyan-300">
                TRAINER CONTROLS
              </span>
            </h2>
            <p class="text-xs text-slate-500 font-medium">Infection Prevention & Control Training Center • Developed by Hammam Jubran Rjoup /MSN, CPIC</p>
          </div>
        </div>
        <button onclick="closeModal('pm-modal')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold flex items-center justify-center transition">
          ✕
        </button>
      </div>

      <!-- QUICK ACTION CONTROLS (AUDIO, TEST SHATTER, TEST ALARM, TRAINER KEY) -->
      <div class="mb-6 p-4 rounded-2xl bg-[#03152c] border-2 border-cyan-500/40 shadow-xl">
        <div class="text-xs font-extrabold uppercase tracking-wider text-cyan-300 mb-3 flex items-center gap-1.5">
          <span>🎮</span> Quick Trainer Action Controls:
        </div>
        <div class="flex items-center gap-3 sm:gap-4 flex-wrap">
          
          <button id="pm-sound-btn" onclick="toggleSound(); updatePMUI();" title="Toggle Sound FX" 
                  class="w-12 h-12 rounded-2xl bg-slate-900 border-2 border-slate-700 hover:border-cyan-400 text-cyan-300 flex items-center justify-center text-2xl transition active:scale-95 shadow-md">
            🔊
          </button>

          <button onclick="sound.playGlassBreak(); triggerShake(); showToast('💥 Test Shatter FX Triggered!', 'Glass crack, noise burst, metal snap, and screen shake active.', 'emerald');" 
                  class="px-5 py-3 rounded-full bg-slate-900 border-2 border-amber-500/60 hover:border-amber-400 text-amber-300 hover:text-amber-200 text-xs sm:text-sm font-black flex items-center gap-2 transition active:scale-95 shadow-lg shadow-amber-500/10">
            <span class="text-base text-pink-500">💥</span>
            <span>Test Shatter FX</span>
          </button>

          <button onclick="triggerBigAlarm();" 
                  class="px-5 py-3 rounded-full bg-red-950/80 border-2 border-red-500/60 hover:border-red-400 text-red-200 hover:text-white text-xs sm:text-sm font-black flex items-center gap-2 transition active:scale-95 shadow-lg shadow-red-500/10">
            <span class="text-base">🚨</span>
            <span>Test Big Alarm</span>
          </button>

          <button onclick="closeModal('pm-modal'); openModal('debrief-modal');" 
                  class="px-5 py-3 rounded-full bg-[#1e1b4b]/90 border-2 border-indigo-500/60 hover:border-indigo-400 text-indigo-200 hover:text-white text-xs sm:text-sm font-black flex items-center gap-2 transition active:scale-95 shadow-lg shadow-indigo-500/10">
            <span class="text-base">📋</span>
            <span>Trainer Key</span>
          </button>

          <button onclick="shuffleAllChoices(true);" 
                  class="px-5 py-3 rounded-full bg-cyan-950/80 border-2 border-cyan-500/60 hover:border-cyan-400 text-cyan-200 hover:text-white text-xs sm:text-sm font-black flex items-center gap-2 transition active:scale-95 shadow-lg shadow-cyan-500/10">
            <span class="text-base">🔀</span>
            <span>Shuffle Choices</span>
          </button>

        </div>
      </div>

      <!-- MANAGEMENT MODULES GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
        
        <!-- MODULE 1: TIMER CONFIGURATION -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-1">
              <span>⏱️</span>
              <span>Simulation Timer Duration</span>
            </div>
            <p class="text-xs text-slate-500 mb-3">Adjust the session countdown timer according to class size:</p>
            <div class="grid grid-cols-4 gap-2 mb-3">
              <button onclick="setTimerMinutes(5)" class="py-1.5 rounded-lg bg-white border border-slate-300 font-bold text-xs hover:border-cyan-500 hover:text-cyan-700">5 Mins</button>
              <button onclick="setTimerMinutes(10)" class="py-1.5 rounded-lg bg-white border border-cyan-500 text-cyan-700 font-bold text-xs">10 Mins</button>
              <button onclick="setTimerMinutes(15)" class="py-1.5 rounded-lg bg-white border border-slate-300 font-bold text-xs hover:border-cyan-500 hover:text-cyan-700">15 Mins</button>
              <button onclick="setTimerMinutes(20)" class="py-1.5 rounded-lg bg-white border border-slate-300 font-bold text-xs hover:border-cyan-500 hover:text-cyan-700">20 Mins</button>
            </div>
          </div>
          <div class="flex items-center justify-between text-xs text-slate-600 pt-2 border-t border-slate-200">
            <span>Current: <strong id="pm-timer-label">10:00</strong></span>
            <button onclick="resetTimer()" class="text-cyan-700 font-bold hover:underline">Reset to Default</button>
          </div>
        </div>

        <!-- MODULE 2: SQUAD & TEAM MANAGEMENT -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-1">
              <span>👥</span>
              <span>Squad & Tournament Roster</span>
            </div>
            <p class="text-xs text-slate-500 mb-3">Manage participant groups freely without fixed names:</p>
            <div class="flex items-center gap-2 mb-3">
              <button onclick="addTeamPrompt()" class="flex-1 py-2 rounded-xl bg-cyan-700 hover:bg-cyan-600 text-white font-bold text-xs transition">
                + Add Group
              </button>
              <button onclick="editCurrentTeamName()" class="flex-1 py-2 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 font-bold text-xs transition">
                ✏️ Rename Active
              </button>
            </div>
          </div>
          <div class="flex items-center justify-between text-xs text-slate-600 pt-2 border-t border-slate-200">
            <span>Active Groups: <strong id="pm-squads-count">2 Groups</strong></span>
            <button onclick="resetAllScores()" class="text-red-600 font-semibold hover:underline">Reset Scores</button>
          </div>
        </div>

        <!-- MODULE 3: DATA EXPORT & ARCHIVE -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-1">
            <span>📊</span>
            <span>Archive & Reports</span>
          </div>
          <p class="text-xs text-slate-500 mb-3">Save rounds into historical archive or download CSV reports:</p>
          <div class="flex items-center gap-2">
            <button onclick="archiveCurrentSession()" class="flex-1 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition flex items-center justify-center gap-1.5 shadow">
              <span>📁</span> Save Archive
            </button>
            <button onclick="exportScoresCSV()" class="flex-1 py-2 rounded-xl bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs transition flex items-center justify-center gap-1.5 shadow">
              <span>📥</span> Download CSV
            </button>
          </div>
        </div>

        <!-- MODULE 4: PRESENTATION DISPLAY -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-1">
            <span>🖥️</span>
